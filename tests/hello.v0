; hello.v0 -- prints "hello, seed\n" (13 literal bytes -- no escape
; processing in this dialect, so \n is the two characters backslash,n)
; and exits 0. Uses a label for the message address (resolved via the
; ABS64 fixup mechanism) rather than a hand-computed absolute address,
; which broke the first time HDR_LEN changed size.
mov rax, 1            ; sys_write
mov rdi, 1             ; fd = stdout
mov rsi, msg            ; addr of msg
mov rdx, 13              ; length
syscall
mov rax, 60               ; sys_exit
mov rdi, 0
syscall
msg:
db "hello, seed\n"
