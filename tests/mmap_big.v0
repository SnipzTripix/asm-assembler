; mmap_big.v0 -- mmap 216 MiB anonymous (what v1 reserves at startup),
; touch nothing, exit. Paired with mmap_small.v0 to isolate how much of
; v1's fixed startup cost is the reservation itself.
mov rdi, 0
mov rsi, 0xD800038
mov rdx, 3
mov r10, 0x22
mov r8, 0xFFFFFFFFFFFFFFFF
mov r9, 0
mov rax, 9
syscall
mov rdi, 0
mov rax, 60
syscall
