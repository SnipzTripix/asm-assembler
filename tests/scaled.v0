; scaled.v0 -- [base + index*scale + disp] addressing. Sums a dq array by
; indexing it directly instead of computing each address with shl+add,
; which is how every table lookup had to be written before this existed.
; 10 + 20 + 30 + 40 = 100, exits with that.
.text
mov rbx, 0                       ; index
mov r14, 0                       ; running total
mov r12, arr

sum_loop:
mov rcx, 4
cmp rbx, rcx
jae sum_done
mov rax, [r12+rbx*8+0]
add r14, rax
add rbx, 1
jmp sum_loop
sum_done:

; also exercise a byte load through a scaled index (scale 1)
mov r12, bytes
mov rbx, 2
movb rcx, [r12+rbx*1+0]          ; bytes[2] = 7
cmp rcx, 7
jne bad

mov rdi, r14
mov rax, 60
syscall

bad:
mov rdi, 1
mov rax, 60
syscall

.data
arr:
dq 10
dq 20
dq 30
dq 40
bytes:
db 5
db 6
db 7
db 8
