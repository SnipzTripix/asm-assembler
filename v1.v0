; ===========================================================================
; v1.v0 -- self-hosting assembler. Assembled by itself:
;   ./v1 v1.v0 v1_next && cmp v1 v1_next
; (byte-identical -- this is the project's own fixed-point test, satisfied.)
; Takes filenames as argv[1]/argv[2] (output gets mode 0755, no separate
; chmod needed); either or both can be omitted, falling back to stdin/
; stdout, so `./v1 < in > out` keeps working exactly as it always did.
; argv[3] is a worker count for parallel assembly (default 1); the output
; is byte-identical whatever it is set to -- see the PARALLEL ASSEMBLY
; section for how that guarantee is kept.
; seed.asm/seed is retired: it only exists to have bootstrapped this file
; once, and is kept around for the historical record and its differential
; test against nasm, not because anything still depends on it.
;
; History: started as a from-scratch reimplementation of seed's logic
; (not a byte-for-byte port) with a trimmed jcc set (je/jne/jl/jae) and no
; lea/test/neg/imul/cmpsb, since none of those existed in the dialect it
; itself implemented at the time. It has since grown past that minimum:
; lea, imul (reg,reg), general negative immediates, a SWAR+bucketed
; mnemonic dispatch, a branchless 256-byte char-class table, an
; FNV-1a-hashed open-addressed symbol table (replaced a linear scan that
; was the actual bottleneck: 55x slower on a 100k-line file with 10,000
; labels, measured, before the fix), and real .text/.data sections (two
; separate PT_LOAD segments, R+X and R, instead of one flat R+X blob) --
; each re-verified against nasm (tests/) and against the fixed-point
; check above before being kept. test/neg/rep-cmpsb are still absent --
; their workarounds (cmp+jl for test, mov-0/sub for neg, a hand-rolled
; byte loop for string compare) are cheap enough that adding the real
; instructions hasn't been worth it.
;
; Register contract (rbx=mmap base, r12=input end, r13=cursor, r14=text
; buffer base, r15=output bump pointer -- into whichever section is
; currently active, see .text/.data below) matches seed's, kept for
; familiarity -- not required by the dialect itself.
;
; Currently supported:
;   mov      imm64 / reg / load / store / label-or-const
;   movb movw movd   8/16/32-bit load (zero-extended) and store; movd's
;            load needs no explicit zero-extend opcode, since any 32-bit
;            register write already clears the upper half in long mode
;   lea, imul (reg,reg and reg,imm), neg
;   add sub and or xor cmp test   reg,reg and reg,imm; immediates may be
;            negative and are range-checked, never truncated
;   shl shr  imm8 or constant, unsigned
;   push pop, jmp je jne jl jae, call (label or register), ret, syscall
;   db       string with \n \t \r \0 \\ \" escapes, or a single byte
;   dw dd dq 2/4/8-byte values; dq also takes a label, which is what
;            makes a jump table expressible
;   resb     reserve N bytes, .bss only
;   equ      compile-time constant; may be referenced before its
;            definition by `mov reg, NAME`, but not by an arithmetic
;            operand, which resolves constants immediately
;   labels, and memory operands [base+disp] and [base+index*scale+disp]
;   .text .data .bss   choose which buffer statements append to; .text is
;            the default, so source that mentions none of them behaves
;            exactly as it did before sections existed
;   %include "file"    spliced in textually before parsing; nests
;
; Invocation: filenames as argv[1]/argv[2] (the output gets mode 0755),
; each falling back to stdin/stdout, and argv[3] as a worker count for
; parallel assembly.
;
; Range checking: values that cannot fit the field they are headed for
; are hard errors ("immediate out of range", "displacement out of
; range"), never silently truncated -- the imm32 of an 81 /digit
; arithmetic form, the disp32 of a memory operand, and the 64-bit
; accumulator in parse_imm are all checked. This matters more than it
; sounds: every one of those silently produced a wrong encoding at some
; point, which is the single worst failure mode an assembler has.
;
; NOT implemented, i.e. what "grow the dialect further" still means here:
; arithmetic at widths other than 64-bit (movb/movw/movd cover memory
; access, but add/sub/cmp and friends are always full-width);
; RIP-relative addressing; the remaining jcc conditions (jg/jle/jb/ja/
; jbe/jge -- reachable by swapping operands or shifting a threshold by
; one, which is what this file does throughout); and short (rel8) jump
; encoding.
;
; rel8 is a deliberate omission rather than a missing feature. Choosing
; it requires knowing whether the target is within 127 bytes, which is
; not known when the instruction is emitted, so it needs a relaxation
; loop: shrink a jump, watch every later address move, repeat until
; nothing changes. That is precisely what the single-pass design trades
; away -- every instruction's length is final the moment it is written,
; which is why forward references need no second parse. It belongs
; behind an explicit optimisation flag, not in the default path.
;
; Mnemonic dispatch is SWAR (a masked-qword compare, see PACK_* below)
; bucketed by first letter.
; ===========================================================================

; --- syscall numbers / mmap flags ---
SYS_read        equ 0
SYS_write       equ 1
SYS_open        equ 2
SYS_close       equ 3
SYS_mmap        equ 9
SYS_fork        equ 57
SYS_exit        equ 60
SYS_wait4       equ 61
O_RDONLY        equ 0
O_WRONLY_CREAT_TRUNC equ 577       ; O_WRONLY(1)|O_CREAT(64)|O_TRUNC(512)
MODE_755        equ 493            ; rwxr-xr-x
MAP_SHARED_ANON equ 0x21           ; MAP_SHARED(1)|MAP_ANONYMOUS(0x20)
PROT_RW         equ 3
MAP_ANON        equ 0x22

; --- memory layout: one mmap, several regions, fixed offsets from rbx ---
; Sized for the spec's own 100k-line benchmark target (a few MB of source
; is common well before that): 64MB each for in/text/data, 16MB symtab
; (an open-addressed hash table -- see fnv1a/find_or_create_symbol --
; SYM_CAP must stay a power of 2 so probing can mask instead of mod), 8MB
; fixups (still a plain append-only array; fixups are only ever scanned
; once, in order, at the end, so they were never the bottleneck). The
; read loop used to stop silently once a 64KB buffer filled, truncating
; the file mid-statement and reporting a confusing "bad operand" at the
; cut point instead of a real "input too large" -- see read_loop's
; overflow check, which now makes that failure mode impossible instead
; of just less likely.
;
; .text/.data (see do_section) are two separate buffers, not one split
; later: a label's value is only meaningful as "offset from MY section's
; base" until resolve_fixups learns the final text size and can compute
; where .data actually lands in the output file (single-pass -- data's
; file position isn't knowable before the whole source has been scanned).
; r15 (the output bump pointer) always points into whichever buffer is
; currently active; every emit_*/do_* routine that writes through it is
; completely unaware sections exist. Only label-value computation, fixup
; creation, section switching, and the final resolve+write step know.
BUF_LEN         equ 0x4000000            ; 64 MiB input capacity
TEXTBUF_OFF     equ 0x4000000            ; 64 MiB text capacity
DATABUF_OFF     equ 0x8000000            ; 64 MiB data capacity
TEXTBUF_CAP     equ 0x4000000
DATABUF_CAP     equ 0x4000000
SYMTAB_META_OFF equ 0xC000000
SYMTAB_OFF      equ 0xC000008
FIXUPS_META_OFF equ 0xD000000            ; + 16MB symtab region
FIXUPS_OFF      equ 0xD000008
LINE_OFF        equ 0xD800000            ; + 8MB fixups region
CUR_SECTION_OFF equ 0xD800008            ; 0 = text (default), 1 = data
SAVED_TEXT_R15_OFF equ 0xD800010         ; the OTHER section's cursor,
SAVED_DATA_R15_OFF equ 0xD800018         ; while it isn't the active one
DATA_FILE_START_OFF equ 0xD800020        ; set once by resolve_fixups
INPUT_FD_OFF    equ 0xD800028            ; argv[1]-opened fd, else 0 (stdin)
OUTPUT_FD_OFF   equ 0xD800030            ; 1 (stdout) until the real file is
                                          ; opened, which happens only once
                                          ; there is output to write
OUTPATH_OFF     equ 0xD8000A0            ; argv[2], or 1 when writing stdout

; --- parallel assembly state (see the "parallel" section further down) ---
JOBS_OFF        equ 0xD800038            ; worker count; 1 = serial path
SHARED_OFF      equ 0xD800040            ; base of the MAP_SHARED result area
MYJOB_OFF       equ 0xD800048            ; which chunk this process owns
DEFLIST_META_OFF equ 0xD800050           ; count of labels defined locally
PAR_NEEDSYM_OFF equ 0xD800058            ; nonzero if any worker deferred a
                                          ; fixup, i.e. if the merge actually
                                          ; needs a symbol table at all
CHUNKTAB_OFF    equ 0xD800060            ; MAX_JOBS * {start,end,section,pad}
PAR_FILTER_OFF  equ 0xE100000            ; 64 KiB byte-per-slot filter over
                                          ; the low 16 bits of a name hash:
                                          ; marks which names some deferred
                                          ; fixup actually wants, so the
                                          ; merge can skip installing the
                                          ; (vast majority of) labels that
                                          ; nothing outside their own chunk
                                          ; ever refers to
PAR_FILTER_MASK equ 0xFFFF
SYMMASK_OFF     equ 0xE110000            ; runtime symbol-table mask. The
                                          ; table is sized for the WHOLE
                                          ; file, but a worker only holds a
                                          ; 1/N share of it, and probing a
                                          ; 16 MiB table scatters those few
                                          ; entries across every page of a
                                          ; private COW copy -- 16 workers
                                          ; then fault in 16 tables' worth
                                          ; of pages. Shrinking each
                                          ; worker's mask keeps the total
                                          ; pages touched the same as serial.
PAR_CONST_META_OFF equ 0xE110008         ; count of prescan-harvested equ
PAR_CONST_OFF   equ 0xE120000            ; {name_ptr, name_len, value, pad}
PAR_CONST_ENT   equ 32
PAR_CONST_CAP   equ 32768
DEFLIST_OFF     equ 0xD900000            ; 8 MiB of symbol-slot pointers, one
                                          ; per label THIS process defined --
                                          ; a worker has to hand its labels to
                                          ; the parent, and walking the whole
                                          ; 16 MiB hash table to find them
                                          ; would cost more than the work it
                                          ; just did
LINE_START_OFF  equ 0xE21FFF0            ; first byte of the current line,
                                          ; for column numbers in errors
MEM_INDEX_OFF   equ 0xE220000            ; parse_mem's index register, or
                                          ; NEG_ONE when the operand has none
MEM_SCALE_OFF   equ 0xE220008            ; SIB scale field (0..3 = 1,2,4,8)
SAVED_BSS_R15_OFF equ 0xE220010          ; .bss cursor while inactive
BSS_VADDR_OFF   equ 0xE220018            ; where .bss lands in memory,
                                          ; relative to LOAD_BASE
MMAP_TOTAL      equ 0x13230000           ; through the end of INCBUF

; .bss gets a real buffer like the other sections, so r15 and every label
; and emitter work there unchanged -- it simply never reaches the output
; file. resb only moves the cursor and writes nothing, so these pages are
; never touched and cost no memory either.
BSSBUF_OFF      equ 0xE230000
BSSBUF_CAP      equ 0x4000000
INCBUF_OFF      equ 0x12230000           ; scratch for one included file at
INCBUF_CAP      equ 0x1000000            ; a time, before it is spliced in

MAX_JOBS        equ 16
PAR_MIN_BYTES   equ 262144               ; below ~256 KiB the fork+merge
                                          ; overhead exceeds what parallel
                                          ; assembly saves, so -j is ignored
CHUNK_ENT       equ 32                   ; {start:8, end:8, section:8, pad:8}

; --- one MAP_SHARED slot per worker: the only memory a worker and the
; parent both see. Everything else a worker touches is copy-on-write
; private, which is exactly why no locking is needed anywhere: workers
; never write to shared state except their own slot, and the parent only
; reads a slot after wait4 has confirmed that worker exited. ---
SLOT_SIZE       equ 0x1000000            ; 16 MiB per worker
SLOT_TEXT_OFF   equ 0x1000               ; meta lives in the first 4 KiB
SLOT_TEXT_CAP   equ 0x600000             ; 6 MiB
SLOT_DATA_OFF   equ 0x601000
SLOT_DATA_CAP   equ 0x400000             ; 4 MiB
SLOT_SYM_OFF    equ 0xA01000
SLOT_SYM_CAP    equ 0x200000             ; 2 MiB / 64 B = 32768 labels
SLOT_FIX_OFF    equ 0xC01000
SLOT_FIX_CAP    equ 0x300000             ; 3 MiB / 48 B = 65536 fixups
SHARED_TOTAL    equ 0x10000000           ; MAX_JOBS * SLOT_SIZE = 256 MiB

; slot meta fields
SM_TEXTSZ       equ 0
SM_DATASZ       equ 8
SM_NSYM         equ 16
SM_NFIX         equ 24
SM_ERR          equ 32                   ; 0 = ok, else a msg id (see wk_die)
SM_ERRLINE      equ 40

SSYM_ENT        equ 64                   ; {name_ptr, name_len, value, section,
                                          ;  hash} -- power of 2 so indexing
                                          ;  is a shift; the hash rides along
                                          ;  so the parent never re-runs FNV
SFIX_ENT        equ 48                   ; {patch_off, patch_sec, kind,
                                          ;  name_ptr, name_len, target_hash}
HDR_LEN         equ 288                  ; Ehdr(64) + 4 * Phdr(56): text, data,
                                         ; bss and GNU_STACK. Constant even
                                         ; when a section is unused: text
                                         ; offsets are fixed at parse time,
                                         ; long before any size is known.
PAGE_SIZE       equ 0x1000
PAGE_MASK       equ 0xFFFFFFFFFFFFF000   ; low32 0xFFFFF000 sign-extends
                                         ; back to this exact 64-bit
                                         ; pattern -- same trick as
                                         ; NEG_ONE/MMAP_ERR_THRESH below
FIX_REL32       equ 0
FIX_ABS64       equ 1
FIX_ENT         equ 32                  ; power of 2 -- v1 has no div, so
                                         ; every table stride here is shl-able
                                         ; {patch_off:8, sym_addr:8, kind:8,
                                         ; section:8} -- exactly 32B, no pad
SYM_ENT         equ 64                  ; power of 2 slot stride: {hash:8,
                                         ; name_ptr:8, name_len:8, value:8,
                                         ; status:8, section:8, 16B pad}
SYM_CAP         equ 262144              ; power of 2 -- and'd, never mod'd
SYM_CAP_MASK    equ 262143
SEC_TEXT        equ 0
SEC_DATA        equ 1
SEC_BSS         equ 2                    ; reserved space: occupies memory
                                          ; at run time but no bytes in the
                                          ; file, so a big zeroed buffer
                                          ; costs nothing on disk
SYM_POP_MAX     equ 229376              ; 7/8 of SYM_CAP -- open addressing
                                         ; degrades well before 100% full,
                                         ; and refusing new symbols past
                                         ; this keeps the probe loop below
                                         ; bounded instead of risking an
                                         ; unterminated scan on a full table
FIX_CAP         equ 200000
REG_ENT_LEN     equ 11
LOAD_BASE       equ 0x400000
FNV_OFFSET      equ 0xCBF29CE484222325
FNV_PRIME       equ 0x100000001B3

; --- SWAR constants for the 8-byte-at-a-time newline scan ---
SWAR_NL         equ 0x0A0A0A0A0A0A0A0A
SWAR_ONES       equ 0x0101010101010101
SWAR_HIGHS      equ 0x8080808080808080

; --- sentinels / two's-complement constants (dialect has no negative
; immediates; grp1-imm ops truncate to 32 bits and the CPU sign-extends at
; run time, so writing the full 64-bit two's-complement pattern here is
; correct for both mov (which keeps all 64 bits) and cmp (which keeps only
; the low 32, then the CPU re-extends them identically) ---
NEG_ONE         equ 0xFFFFFFFFFFFFFFFF
MMAP_ERR_THRESH equ 0xFFFFFFFFFFFFF001

; --- ASCII codes (dialect has no character-literal syntax) ---
CLS_SPACE       equ 1
CLS_NL          equ 2
CLS_ISTART      equ 4
CLS_ICONT       equ 8
CLS_DIGIT       equ 16
CLS_HEX         equ 32

CH_TAB          equ 9
CH_NL           equ 10
CH_SPACE        equ 32
CH_QUOTE        equ 34
CH_DOT          equ 46
CH_PLUS         equ 43
CH_COMMA        equ 44
CH_MINUS        equ 45
CH_0            equ 48
CH_9PLUS1       equ 58
CH_COLON        equ 58
CH_SEMI         equ 59
CH_A            equ 65
CH_ZPLUS1       equ 91
CH_LBRACKET     equ 91
CH_RBRACKET     equ 93
CH_US           equ 95
CH_a            equ 97
CH_STAR         equ 42
CH_PERCENT      equ 37
CH_BACKSLASH    equ 92
CH_n            equ 110
CH_r            equ 114
CH_t            equ 116
CH_x            equ 120
CH_zPLUS1       equ 123
CH_fPLUS1       equ 103

; --- SWAR-packed mnemonics (little-endian bytes packed into one qword;
; generated mechanically, see tests/, not hand-transposed): a masked
; single-register compare replaces a byte-loop per candidate mnemonic ---
PACK_MOV        equ 0x766F6D
PACK_MOVB       equ 0x62766F6D
PACK_MOVW       equ 0x77766F6D
PACK_MOVD       equ 0x64766F6D
PACK_SYSCALL    equ 0x6C6C6163737973
PACK_RET        equ 0x746572
PACK_DB         equ 0x6264
PACK_ADD        equ 0x646461
PACK_SUB        equ 0x627573
PACK_AND        equ 0x646E61
PACK_OR         equ 0x726F
PACK_XOR        equ 0x726F78
PACK_CMP        equ 0x706D63
PACK_SHL        equ 0x6C6873
PACK_SHR        equ 0x726873
PACK_JMP        equ 0x706D6A
PACK_JE         equ 0x656A
PACK_JNE        equ 0x656E6A
PACK_JL         equ 0x6C6A
PACK_JAE        equ 0x65616A
PACK_CALL       equ 0x6C6C6163
PACK_PUSH       equ 0x68737570
PACK_POP        equ 0x706F70
PACK_LEA        equ 0x61656C
PACK_IMUL       equ 0x6C756D69
PACK_TEXT       equ 0x74786574
PACK_DATA       equ 0x61746164
PACK_TEST       equ 0x74736574
PACK_NEG        equ 0x67656E
PACK_DW         equ 0x7764
PACK_DD         equ 0x6464
PACK_DQ         equ 0x7164
PACK_BSS        equ 0x737362
PACK_RESB       equ 0x62736572

; ===========================================================================
; entry point -- mmap the working set, read all of stdin, parse, resolve
; fixups, build the output ELF header, write it out, exit.
; ===========================================================================
start:
; --- optional argv[1]/argv[2] as input/output filenames, read before any
; push/call shifts rsp away from the exact SysV entry layout: [rsp]=argc,
; [rsp+8]=argv[0], [rsp+16]=argv[1], [rsp+24]=argv[2]. Falls back to
; stdin/stdout (fd 0/1) when the corresponding arg is absent, so
; `./v1 < in > out` keeps working unchanged. r13/r14 are free to use as
; temporaries here -- their permanent roles (cursor, text base) aren't
; assigned until after mmap below, well after these fds are stashed into
; memory.
mov r13, 0                          ; input_fd, default stdin
mov r14, 1                          ; output_fd, default stdout
mov rax, [rsp+0]                    ; argc
cmp rax, 2
jl start_check_output
mov rdi, [rsp+16]                   ; argv[1]
mov rsi, O_RDONLY
mov rax, SYS_open
syscall
cmp rax, 0
jl die_open
mov r13, rax
start_check_output:
; Only remember argv[2]; the file is not created until there is output to
; put in it. Opening here left a 0-byte executable behind whenever
; assembly failed later in the file -- a truncated artifact that looks
; like a successful build.
mov rax, [rsp+0]                    ; reload argc -- open's return value
                                    ; just clobbered rax
cmp rax, 3
jl start_argv_done
mov r14, [rsp+24]                   ; argv[2] path, opened at write time
start_argv_done:
; argv[3] = worker count (default 1 = the original serial path). Parsed
; here, before mmap, and stashed in r11 -- the private region it will
; live in does not exist yet.
mov r11, 1
mov rax, [rsp+0]
cmp rax, 4
jl start_jobs_done
mov rsi, [rsp+32]                   ; argv[3]
mov r11, 0
start_jobs_digit:
movb rax, [rsi+0]
cmp rax, CH_0
jl start_jobs_check
cmp rax, CH_9PLUS1
jae start_jobs_check
sub rax, CH_0
mov rcx, r11
shl r11, 3
shl rcx, 1
add r11, rcx                        ; r11 = r11*10 (no imul before the
add r11, rax                        ; encoder is even mapped in)
add rsi, 1
jmp start_jobs_digit
start_jobs_check:
cmp r11, 1
jl start_jobs_bad
cmp r11, MAX_JOBS
jae start_jobs_clamp
jmp start_jobs_done
start_jobs_clamp:
mov r11, MAX_JOBS
jmp start_jobs_done
start_jobs_bad:
mov r11, 1
start_jobs_done:

mov rdi, 0
mov rsi, MMAP_TOTAL
mov rdx, PROT_RW
mov r10, MAP_ANON
mov r8, NEG_ONE
mov r9, 0
push r11                            ; syscall clobbers rcx and r11 (it
mov rax, SYS_mmap                   ; parks the return address and RFLAGS
syscall                             ; there) -- the job count cannot ride
pop r11                             ; through in r11, and when it did, the
cmp rax, MMAP_ERR_THRESH            ; garbage left behind made every run
jae die_mmap                        ; think it should fork, which is a
mov rbx, rax                        ; fork bomb, not a bug you debug twice

mov rax, rbx
add rax, INPUT_FD_OFF
mov [rax+0], r13
mov rax, rbx
add rax, OUTPATH_OFF
mov [rax+0], r14
mov rax, rbx
add rax, OUTPUT_FD_OFF
mov rcx, 1                          ; stdout until argv[2] is opened
mov [rax+0], rcx
mov rax, rbx
add rax, JOBS_OFF
mov [rax+0], r11
mov rax, rbx
add rax, MYJOB_OFF                  ; the parent is not a worker; workers
mov rcx, NEG_ONE                    ; overwrite this with their index
mov [rax+0], rcx
mov rax, rbx
add rax, SYMMASK_OFF                ; full-size table unless a worker
mov rcx, SYM_CAP_MASK               ; narrows it for itself
mov [rax+0], rcx

; --- MAP_SHARED result area, only when actually running parallel ---
mov rax, rbx
add rax, SHARED_OFF
mov rcx, 0
mov [rax+0], rcx
cmp r11, 1
je start_no_shared
push r11
mov rdi, 0
mov rsi, SHARED_TOTAL
mov rdx, PROT_RW
mov r10, MAP_SHARED_ANON
mov r8, NEG_ONE
mov r9, 0
mov rax, SYS_mmap
syscall
pop r11
cmp rax, MMAP_ERR_THRESH
jae die_mmap
mov rcx, rbx
add rcx, SHARED_OFF
mov [rcx+0], rax
start_no_shared:

mov r14, rbx
add r14, TEXTBUF_OFF             ; r14 = text buffer base, constant for
                                 ; the whole run (data's base is always
                                 ; just rbx+DATABUF_OFF, computed inline
                                 ; wherever needed -- not worth its own
                                 ; register)

mov r12, 0
read_loop:
mov rdi, rbx
add rdi, r12
mov rsi, rdi
mov rdx, BUF_LEN
sub rdx, r12
cmp rdx, 0
je read_check_overflow
mov rdi, rbx
add rdi, INPUT_FD_OFF
mov rdi, [rdi+0]
mov rax, SYS_read
syscall
cmp rax, 0
jl die_read
je read_done
add r12, rax
jmp read_loop
read_check_overflow:
; inbuf is exactly full -- probe for one more byte so a file bigger than
; BUF_LEN fails cleanly instead of silently truncating mid-statement
mov rdi, rbx
add rdi, INPUT_FD_OFF
mov rdi, [rdi+0]
mov rsi, rsp
sub rsi, 64
mov rdx, 1
mov rax, SYS_read
syscall
cmp rax, 0
jl die_read
cmp rax, 0
jne die_input_too_large        ; not negative and not zero -> read a real
                               ; byte -- input didn't fit in BUF_LEN
read_done:
add r12, rbx
mov rax, rbx
add rax, LINE_START_OFF
mov [rax+0], rbx           ; valid before expand_includes can fail
mov rax, rbx
add rax, LINE_OFF
mov rcx, 1
mov [rax+0], rcx
call expand_includes               ; splice included files in before any
                                    ; parsing, chunking or line counting
mov r13, rbx
mov r15, r14
add r15, HDR_LEN
mov rax, rbx
add rax, LINE_OFF
mov rcx, 1
mov [rax+0], rcx
mov rax, rbx
add rax, LINE_START_OFF
mov [rax+0], r13

; --- section state: start in .text, remember both cursors ---
mov rax, rbx
add rax, CUR_SECTION_OFF
mov rcx, SEC_TEXT
mov [rax+0], rcx
mov rax, rbx
add rax, SAVED_TEXT_R15_OFF
mov [rax+0], r15
mov rax, rbx
add rax, SAVED_DATA_R15_OFF
mov rcx, rbx
add rcx, DATABUF_OFF
mov [rax+0], rcx
mov rax, rbx
add rax, SAVED_BSS_R15_OFF
mov rcx, rbx
add rcx, BSSBUF_OFF
mov [rax+0], rcx

; --- fork out to the parallel driver when more than one worker was asked
; for. par_assemble returns only in the parent, with everything merged and
; both section cursors set, ready for the shared output stage. ---
; Below a certain size, forking and merging costs more than the assembly
; itself, so a small file quietly falls back to the serial path: asking
; for workers should never make a build slower than not asking.
mov rax, r12
sub rax, rbx                        ; input length
cmp rax, PAR_MIN_BYTES
jae par_size_ok
mov rax, rbx
add rax, JOBS_OFF
mov rcx, 1
mov [rax+0], rcx
par_size_ok:
mov rax, rbx
add rax, JOBS_OFF
mov rax, [rax+0]
cmp rax, 1
je stmt_loop
call par_assemble
jmp build_output

stmt_loop:
cmp r13, r12
jae parse_done
call skip_ws
cmp r13, r12
jae parse_done
movb rax, [r13+0]
cmp rax, CH_NL
je blank_line
cmp rax, CH_SEMI
je comment_line
call parse_stmt
call check_out_bounds
jmp stmt_loop
blank_line:
add r13, 1
mov rax, rbx
add rax, LINE_OFF
mov rcx, [rax+0]
add rcx, 1
mov [rax+0], rcx
mov rax, rbx
add rax, LINE_START_OFF
mov [rax+0], r13
jmp stmt_loop
comment_line:
call skip_to_eol
jmp stmt_loop
parse_done:
; a worker stops here: its chunk is assembled but nothing can be resolved
; until every other chunk's labels are known, which only the parent sees
mov rax, rbx
add rax, MYJOB_OFF
mov rax, [rax+0]
cmp rax, NEG_ONE
jne par_worker_emit

call resolve_fixups                 ; also finalizes both section sizes
                                    ; and DATA_FILE_START -- read those
                                    ; back out instead of trusting live
                                    ; r15, which may currently be in
                                    ; whichever section wasn't scanned last

build_output:
mov rax, rbx
add rax, SAVED_TEXT_R15_OFF
mov rax, [rax+0]
sub rax, r14                        ; rax = text_size (header + text)
mov rsi, rax                        ; keep it -- needed for the write step
mov rax, rbx
add rax, SAVED_DATA_R15_OFF
mov rax, [rax+0]
mov rcx, rbx
add rcx, DATABUF_OFF
sub rax, rcx                        ; rax = data_size
mov rdi, rax                        ; keep it too
mov rax, rbx
add rax, DATA_FILE_START_OFF
mov rax, [rax+0]                    ; rax = DATA_FILE_START (page-aligned)

; --- build the ELF header for the OUTPUT program into r14[0..HDR_LEN) ---
; Elf64_Ehdr byte offsets: 0 ident[16] 16 type 18 machine 20 version
;   24 entry 32 phoff 40 shoff 48 flags 52 ehsize 54 phentsize 56 phnum
;   58 shentsize 60 shnum 62 shstrndx                    (total 64)
;
; Program headers are appended one after another from offset 64, and only
; for segments that actually exist. They used to live in three fixed
; slots with a chained phnum count, which got .bss wrong whenever .data
; was empty: the chain returned 1 at the first test and never looked at
; bss, so a program with .bss and no .data emitted no bss segment at all
; and segfaulted on its first access. Counting and placement are now
; driven by the same has_* tests, so the two cannot disagree.
;
; rsi = text_size, rdi = data_size, rax = DATA_FILE_START on entry; r8
; picks up bss_size, and r12 becomes the phdr write cursor (the input is
; long since consumed by this point).
mov r8, rbx
add r8, SAVED_BSS_R15_OFF
mov r8, [r8+0]
mov rcx, rbx
add rcx, BSSBUF_OFF
sub r8, rcx                         ; r8 = bss_size

mov rcx, 127
movb [r14+0], rcx
mov rcx, 69
movb [r14+1], rcx
mov rcx, 76
movb [r14+2], rcx
mov rcx, 70
movb [r14+3], rcx
mov rcx, 2                          ; ELFCLASS64
movb [r14+4], rcx
mov rcx, 1                          ; ELFDATA2LSB
movb [r14+5], rcx
movb [r14+6], rcx                   ; EV_CURRENT
mov rcx, 0
movb [r14+7], rcx
mov [r14+8], rcx                    ; ABI version + padding

mov rcx, 2                          ; e_type = ET_EXEC
movb [r14+16], rcx
mov rcx, 0
movb [r14+17], rcx
mov rcx, 62                         ; e_machine = EM_X86_64
movb [r14+18], rcx
mov rcx, 0
movb [r14+19], rcx
mov rcx, 1                          ; e_version
movb [r14+20], rcx
mov rcx, 0
movb [r14+21], rcx
movb [r14+22], rcx
movb [r14+23], rcx

mov rcx, LOAD_BASE
add rcx, HDR_LEN
mov [r14+24], rcx                   ; e_entry
mov rcx, 64
mov [r14+32], rcx                   ; e_phoff
mov rcx, 0
mov [r14+40], rcx                   ; e_shoff: no section headers

movb [r14+48], rcx                  ; e_flags
movb [r14+49], rcx
movb [r14+50], rcx
movb [r14+51], rcx
mov rcx, 64
movb [r14+52], rcx                  ; e_ehsize
mov rcx, 0
movb [r14+53], rcx
mov rcx, 56
movb [r14+54], rcx                  ; e_phentsize
mov rcx, 0
movb [r14+55], rcx

; --- program headers, packed in order, counting as we go ---
mov r12, r14
add r12, 64                         ; phdr write cursor
mov r11, 0                          ; phdr count

; text: always present, R+X, and it carries the ELF header itself
push rax
push rdi
push rsi
push r8                             ; r8 is bss_size and must survive
mov rdi, r12
mov r10, 1                          ; PT_LOAD
mov rcx, 5                          ; PF_R|PF_X
mov rdx, 0                          ; vaddr offset
mov r8, rsi                         ; filesz = text_size
mov r9, rsi                         ; memsz  = text_size
mov rsi, 0                          ; p_offset
call write_phdr
pop r8
pop rsi
pop rdi
pop rax
add r12, 56
add r11, 1

; data: only when non-empty. R+W, not R -- initialized data that cannot
; be written to is a .rodata wearing the wrong name, and storing to it
; faulted with no diagnostic.
cmp rdi, 0
je phdr_no_data
push rax
push rdi
push rsi
mov rsi, rax                        ; p_offset = DATA_FILE_START
mov rdx, rax                        ; same vaddr offset
mov r9, rdi                         ; memsz = filesz = data_size
mov rdi, r12
mov r10, 1
mov rcx, 6                          ; PF_R|PF_W
push r8
mov r8, r9                          ; filesz
call write_phdr
pop r8
pop rsi
pop rdi
pop rax
add r12, 56
add r11, 1
phdr_no_data:

; bss: only when non-empty. No file content at all -- filesz 0, memsz the
; reserved size, which is what makes the kernel zero-fill it.
cmp r8, 0
je phdr_no_bss
push rax
push rdi
push rsi
push r8
mov rdx, rbx
add rdx, BSS_VADDR_OFF
mov rdx, [rdx+0]                    ; vaddr offset
mov rsi, rax
add rsi, rdi                        ; p_offset: just past .data in the file
mov r9, r8                          ; memsz = reserved size
mov r8, 0                           ; filesz = 0
mov rdi, r12
mov r10, 1
mov rcx, 6                          ; PF_R|PF_W
call write_phdr
pop r8
pop rsi
pop rdi
pop rax
add r12, 56
add r11, 1
phdr_no_bss:

; PT_GNU_STACK: without it the kernel gives the process an executable
; stack. All-zero addresses and sizes; only the flags matter.
push rax
push rdi
push rsi
push r8
mov rdi, r12
mov r10, 0x6474E551
mov rcx, 6                          ; RW, deliberately not X
mov rsi, 0
mov rdx, 0
mov r8, 0
mov r9, 0
call write_phdr_raw                 ; no LOAD_BASE bias on a null vaddr
pop r8
pop rsi
pop rdi
pop rax
add r11, 1

movb [r14+56], r11                  ; e_phnum
mov rcx, 0
movb [r14+57], rcx
movb [r14+58], rcx
movb [r14+59], rcx
movb [r14+60], rcx
movb [r14+61], rcx
movb [r14+62], rcx
movb [r14+63], rcx
; --- write the output image: header+text, then zero padding up to the
; page boundary (sourced from r14 past text_size, which is guaranteed
; zero -- fresh mmap, never written past there), then data. A syscall
; only clobbers rax/rcx/r11 -- rdi/rsi/rdx/r8/r9/r10 all survive it, so
; DATA_FILE_START/text_size/data_size move into r8/r9/r10 once, up front,
; instead of being re-derived (or worse, lost) between the three writes.
mov r8, rax                         ; r8 = DATA_FILE_START
mov r9, rsi                         ; r9 = text_size
mov r10, rdi                        ; r10 = data_size

; Create the output file now, at the first moment there is something
; valid to put in it -- see start_check_output.
mov rax, rbx
add rax, OUTPATH_OFF
mov rdi, [rax+0]
cmp rdi, 1
je out_is_stdout
push r8
push r9
push r10
mov rsi, O_WRONLY_CREAT_TRUNC
mov rdx, MODE_755
mov rax, SYS_open
syscall
pop r10
pop r9
pop r8
cmp rax, 0
jl die_open
mov rcx, rbx
add rcx, OUTPUT_FD_OFF
mov [rcx+0], rax
out_is_stdout:

mov rdx, r9
mov rsi, r14
mov rdi, rbx
add rdi, OUTPUT_FD_OFF
mov rdi, [rdi+0]
mov rax, SYS_write
syscall
cmp rax, 0
jl die_write

; An empty .data needs neither the alignment padding nor a data write --
; without this the output of every section-less program was rounded up to
; a full page of mostly zeros.
cmp r10, 0
je write_done

mov rdx, r8
sub rdx, r9                         ; padding_size = DATA_FILE_START - text_size
mov rsi, r14
add rsi, r9                         ; source = r14+text_size (zero there)
mov rdi, rbx
add rdi, OUTPUT_FD_OFF
mov rdi, [rdi+0]
mov rax, SYS_write
syscall
cmp rax, 0
jl die_write

mov rdx, r10
mov rsi, rbx
add rsi, DATABUF_OFF
mov rdi, rbx
add rdi, OUTPUT_FD_OFF
mov rdi, [rdi+0]
mov rax, SYS_write
syscall
cmp rax, 0
jl die_write
write_done:

; --- close whichever fds we actually opened (argv-provided ones only --
; the stdin/stdout defaults are left alone) ---
mov rax, rbx
add rax, INPUT_FD_OFF
mov rax, [rax+0]
cmp rax, 0
je close_input_skip
mov rdi, rax
mov rax, SYS_close
syscall
close_input_skip:
mov rax, rbx
add rax, OUTPUT_FD_OFF
mov rax, [rax+0]
cmp rax, 1
je close_output_skip
mov rdi, rax
mov rax, SYS_close
syscall
close_output_skip:

mov rdi, 0
mov rax, SYS_exit
syscall

; ===========================================================================
; skip_ws -- advance r13 past spaces/tabs only (not newline)
; ===========================================================================
skip_ws:
cmp r13, r12
jae skip_ws_ret
movb rax, [r13+0]
push rdx                            ; many callers hold live state in rdx
mov rdx, class_tbl                  ; across a skip_ws call (the old,
add rdx, rax                        ; pre-table skip_ws never touched it,
movb rdx, [rdx+0]                   ; so nothing preserved it explicitly)
and rdx, CLS_SPACE
cmp rdx, 0
pop rdx
je skip_ws_ret
add r13, 1
jmp skip_ws
skip_ws_ret:
ret

; ===========================================================================
; skip_to_eol -- advance r13 to '\n' (consumed) or end of input
; ===========================================================================
skip_to_eol:
cmp r13, r12
jae skip_to_eol_ret
movb rax, [r13+0]
add r13, 1
cmp rax, CH_NL
jne skip_to_eol
push rax
mov rax, rbx
add rax, LINE_OFF
mov rcx, [rax+0]
add rcx, 1
mov [rax+0], rcx
mov rax, rbx
add rax, LINE_START_OFF            ; r13 is just past the newline, i.e. the
mov [rax+0], r13                   ; first byte of the next line -- kept so
pop rax                            ; errors can report a column
skip_to_eol_ret:
ret

; ===========================================================================
; scan_ident -- scan [A-Za-z0-9_]+ at r13
;   out: rsi = start, rcx = length; r13 advanced past it
; ===========================================================================
scan_ident:
mov rsi, r13
scan_ident_loop:
cmp r13, r12
jae scan_ident_done
movb rax, [r13+0]
push rdx                            ; same rdx-preservation concern as
mov rdx, class_tbl                  ; skip_ws -- see its comment
add rdx, rax
movb rdx, [rdx+0]
and rdx, CLS_ICONT
cmp rdx, 0
pop rdx
je scan_ident_done
add r13, 1
jmp scan_ident_loop
scan_ident_done:
mov rcx, r13
sub rcx, rsi
ret

; ===========================================================================
; bytes_eq -- in: rsi/rcx = candidate ptr/len, rdi/rdx = literal ptr/len
;   out: rax = 1 if equal, 0 if not. Byte-at-a-time via movb (the dialect
;   has no rep/cmpsb). Only rax is genuinely clobbered -- r8-r11 are saved
;   and restored internally, so callers (parse_reg, find_or_create_symbol,
;   the mnemonic dispatch chain) can keep their own loop state live in
;   those registers across a call here without thinking about it.
; ===========================================================================
bytes_eq:
cmp rcx, rdx
jne bytes_eq_no
push r8
push r9
push r10
push r11
mov r8, rsi
mov r9, rdi
mov r10, rcx
bytes_eq_loop:
cmp r10, 0
je bytes_eq_yes
movb r11, [r8+0]
movb rax, [r9+0]
cmp r11, rax
jne bytes_eq_no_pop
add r8, 1
add r9, 1
sub r10, 1
jmp bytes_eq_loop
bytes_eq_yes:
pop r11
pop r10
pop r9
pop r8
mov rax, 1
ret
bytes_eq_no_pop:
pop r11
pop r10
pop r9
pop r8
mov rax, 0
ret
bytes_eq_no:
mov rax, 0
ret

; ===========================================================================
; swar_pack -- in: rdi = ptr, rcx = length (0..8) -- out: rax = the 8-byte
; over-read at [rdi] masked down to the low `length` bytes, little-endian.
; The over-read is safe: candidate words are always scanned from inbuf,
; which is mmap'd with slack past the real input (same reasoning as
; bytes_eq's byte loop, just one load instead of many). Masking by the
; CANDIDATE's own length (not a fixed width) means a single `cmp` against
; a mnemonic's packed constant checks content and length at once -- a
; length-3 candidate can never equal PACK_MOVB, which has a nonzero 4th
; byte, because masking to 3 bytes zeroes exactly that byte in candidates
; too.
; ===========================================================================
swar_pack:
mov rax, [rdi+0]
mov rdx, 1
mov r8, 0
swar_pack_maskloop:
cmp r8, rcx
je swar_pack_maskdone
shl rdx, 8
add r8, 1
jmp swar_pack_maskloop
swar_pack_maskdone:
sub rdx, 1
and rax, rdx
ret

; ===========================================================================
; parse_reg -- match a register name at r13 against reg_table
;   out: rax = register number 0..15, or NEG_ONE if no match (r13 left
;   unchanged on failure, same contract as seed's version)
;   clob: rax, rcx, rdx, rsi, rdi, r8, r9, r10, r11
; ===========================================================================
parse_reg:
mov r10, reg_table
mov r11, 16
parse_reg_try:
movb rcx, [r10+0]
mov rsi, r13
mov rdi, r10
add rdi, 3
mov rdx, rcx
call bytes_eq
cmp rax, 1
jne parse_reg_next
movb rdx, [r10+0]
mov rax, r13
add rax, rdx
cmp rax, r12
jae parse_reg_accept
movb rax, [rax+0]
mov rdx, class_tbl
add rdx, rax
movb rdx, [rdx+0]
and rdx, CLS_ICONT
cmp rdx, 0
je parse_reg_accept
jmp parse_reg_next
parse_reg_accept:
movb rax, [r10+0]
add r13, rax
movb rax, [r10+1]
ret
parse_reg_next:
add r10, REG_ENT_LEN
sub r11, 1
cmp r11, 0
jne parse_reg_try
mov rax, NEG_ONE
ret

; ===========================================================================
; parse_imm -- decimal or 0x-hex unsigned value at r13
;   out: rax = value; r13 advanced past the digits
;   clob: rax, rcx, rdx
; ===========================================================================
parse_imm:
push r8                         ; r8 = decimal overflow threshold, live for
mov r8, 1844674407370955162     ; the whole call; restored at parse_imm_done
                                ; so this routine now PRESERVES r8 rather
                                ; than clobbering it (strictly safer for
                                ; every existing caller)
mov rax, 0
cmp r13, r12
jae die_bad_operand
movb rcx, [r13+0]
cmp rcx, CH_0
jne parse_imm_decimal
mov rdx, r13
add rdx, 1
cmp rdx, r12
jae parse_imm_decimal
movb rcx, [r13+1]
cmp rcx, CH_x
jne parse_imm_decimal
add r13, 2
parse_imm_hex_loop:
cmp r13, r12
jae parse_imm_done
movb rcx, [r13+0]
cmp rcx, CH_0
jl parse_imm_done
cmp rcx, CH_9PLUS1
jae parse_imm_hex_alpha
sub rcx, CH_0
jmp parse_imm_hex_acc
parse_imm_hex_alpha:
cmp rcx, CH_A
jl parse_imm_done
cmp rcx, CH_fPLUS1
jae parse_imm_done
cmp rcx, CH_ZPLUS1
jl parse_imm_hex_upper
cmp rcx, CH_a
jl parse_imm_done
sub rcx, CH_a
add rcx, 10
jmp parse_imm_hex_acc
parse_imm_hex_upper:
sub rcx, CH_A
add rcx, 10
parse_imm_hex_acc:
mov rdx, rax                    ; overflow guard: any of the top 4 bits
shr rdx, 60                     ; set means the shl below would shift a
cmp rdx, 0                      ; significant digit off the end
jne die_imm_range
shl rax, 4
add rax, rcx
add r13, 1
jmp parse_imm_hex_loop
parse_imm_decimal:
mov rax, 0
parse_imm_dec_loop:
cmp r13, r12
jae parse_imm_done
movb rcx, [r13+0]
cmp rcx, CH_0
jl parse_imm_done
cmp rcx, CH_9PLUS1
jae parse_imm_done
sub rcx, CH_0
cmp rax, r8                     ; r8 = floor((2^64-1)/10)+1, loaded once
jae die_imm_range               ; at entry: *10 below would wrap
mov rdx, rax
shl rax, 1
shl rdx, 3
add rax, rdx                    ; rax = 10 * previous
mov rdx, rax                    ; keep it to detect wrap on the digit add
add rax, rcx
cmp rax, rdx                    ; a wrapped add lands BELOW its input, and
jae parse_imm_dec_noflow        ; adding 0..9 can never legitimately do
jmp die_imm_range               ; that
parse_imm_dec_noflow:
add r13, 1
jmp parse_imm_dec_loop
parse_imm_done:
pop r8
ret

; ===========================================================================
; check_imm32 / check_disp32 -- in: rax = value. Dies unless it fits in a
; signed 32-bit field. Logically-shifting right by 31 leaves all-zeros for
; a value in 0..0x7FFFFFFF and exactly 0x1FFFFFFFF for one in
; -0x80000000..-1; any other pattern means the imm32/disp32 field this
; value is headed for would silently drop significant bits. Two entry
; points purely so the error message names the right field.
;   preserves rax; clob rcx
; ===========================================================================
check_imm32:
push rax
shr rax, 31
cmp rax, 0
je check_imm32_ok
mov rcx, 0x1FFFFFFFF
cmp rax, rcx
jne die_imm_range
check_imm32_ok:
pop rax
ret

check_disp32:
push rax
shr rax, 31
cmp rax, 0
je check_disp32_ok
mov rcx, 0x1FFFFFFFF
cmp rax, rcx
jne die_disp_range
check_disp32_ok:
pop rax
ret

; ===========================================================================
; parse_signed_imm -- optional leading '-', then parse_imm's magnitude.
;   out: rax = value (two's complement negated if '-' was present); r13
;   advanced. Unlike parse_mem's inline sign handling (which only ever
;   needed this for displacements), this is the general "imm operand can
;   be negative" entry point: do_mov's numeric branch and each arithmetic
;   handler's imm branch use it instead of calling parse_imm directly.
; ===========================================================================
parse_signed_imm:
cmp r13, r12
jae die_bad_operand
movb rax, [r13+0]
cmp rax, CH_MINUS
jne parse_signed_imm_pos
add r13, 1
call parse_imm
mov rdx, 0
sub rdx, rax
mov rax, rdx
ret
parse_signed_imm_pos:
call parse_imm
ret

; ===========================================================================
; find_or_create_symbol -- in: rsi/rcx = name ptr/len (points into inbuf,
; which stays mapped the whole run, so no string copy needed)
;   out: rax = symbol index, existing or freshly appended (value=0,status=0)
;   clob: rax, rcx, rdx, rdi, r8, r9 (rsi preserved -- bytes_eq only reads it)
; symtab entry (32B): {name_ptr:8, name_len:8, value:8, status:8}
; status: 0=undefined(placeholder) 1=LABEL 2=CONST
; ===========================================================================
; ===========================================================================
; fnv1a -- in: rsi = ptr, rcx = len -> out: rax = 64-bit FNV-1a hash.
; The multiply-by-prime step is why imul got added to this dialect in the
; first place -- there's no way to write a hash function without one.
;   clob: rax, r8, r9, r10, r11
; ===========================================================================
fnv1a:
mov rax, FNV_OFFSET
mov r8, rsi
mov r9, 0
fnv1a_loop:
cmp r9, rcx
je fnv1a_done
movb r10, [r8+0]
xor rax, r10
mov r11, FNV_PRIME
imul rax, r11
add r8, 1
add r9, 1
jmp fnv1a_loop
fnv1a_done:
ret

; ===========================================================================
; find_or_create_symbol -- in: rsi/rcx = name ptr/len (points into inbuf,
; which stays mapped the whole run, so no string copy needed).
;   out: rax = SLOT ADDRESS (not an index -- open addressing means a
;   symbol's slot can be anywhere, so every caller that used to store/pass
;   a small index now stores/passes this pointer instead; define_label,
;   define_const, add_fixup and resolve_fixups all changed for it, but
;   parse_stmt/do_mov/the arithmetic handlers didn't need to, since they
;   only ever pass this value through opaquely).
;   Open addressing, linear probing, power-of-2 capacity (SYM_CAP_MASK),
;   hash stored in the slot so a probe can reject a mismatch without
;   touching the string table -- this is what turned symbol lookup from
;   O(n) per call (a real bottleneck: 55x slower on a 100k-line file with
;   10,000 labels, measured) into O(1) average.
; symtab slot (64B): {hash:8, name_ptr:8, name_len:8, value:8, status:8}
; ===========================================================================
find_or_create_symbol:
push rsi
push rcx
call fnv1a
pop rcx
pop rsi
mov r8, rax                         ; r8 = hash
mov r9, rax
mov rdx, rbx
add rdx, SYMMASK_OFF
mov rdx, [rdx+0]                    ; runtime mask (see SYMMASK_OFF)
and r9, rdx                         ; r9 = probe index
focs_probe:
mov r10, r9
shl r10, 6                          ; *64 (SYM_ENT)
mov r11, rbx
add r11, SYMTAB_OFF
add r10, r11                        ; r10 = slot address
; "Is this slot free?" must test the NAME, not the status. A symbol
; referenced before it is defined lives here as a placeholder with
; status 0, and testing status would call that slot empty and let the
; next colliding name overwrite it -- silently re-pointing every fixup
; that already recorded this slot's address at a different symbol. That
; is a wrong encoding, not an error, and it stayed hidden for as long as
; the table was so large that collisions never happened.
mov rax, [r10+8]                    ; name_ptr: zero only if never used
cmp rax, 0
je focs_create
mov rax, [r10+0]                    ; stored hash
cmp rax, r8
jne focs_next
mov rax, [r10+16]                   ; stored name_len
cmp rax, rcx
jne focs_next
mov rdi, [r10+8]                    ; stored name_ptr
mov rdx, rcx
call bytes_eq                       ; rsi/rcx (candidate) survive this
cmp rax, 1
jne focs_next
mov rax, r10
ret
focs_next:
add r9, 1
mov rdx, rbx
add rdx, SYMMASK_OFF
mov rdx, [rdx+0]
and r9, rdx
jmp focs_probe
focs_create:
mov r11, rbx
add r11, SYMTAB_META_OFF        ; repurposed as a population counter --
mov rax, [r11+0]                ; the hash table has no "count of live
cmp rax, SYM_POP_MAX            ; entries scanned so far" to track otherwise
jae die_toomany_syms
add rax, 1
mov [r11+0], rax
mov [r10+0], r8
mov [r10+8], rsi
mov [r10+16], rcx
mov rax, 0
mov [r10+24], rax
mov [r10+32], rax
mov rax, r10
ret

; ===========================================================================
; define_label -- in: rax = symbol slot address. Sets value = current
; output offset, status = 1 (LABEL). Errors if status is already nonzero.
; ===========================================================================
; ===========================================================================
; section_base -- out: rax = current section's buffer base address, rdx =
; current section id (SEC_TEXT/SEC_DATA). Shared by define_label,
; add_fixup, and the two label-address-fixup call sites, all of which
; need "where does an offset in the CURRENT section actually live".
;   clob: rax, rcx, rdx
; ===========================================================================
section_base:
mov rax, rbx
add rax, CUR_SECTION_OFF
mov rdx, [rax+0]
cmp rdx, SEC_TEXT
je section_base_text
cmp rdx, SEC_BSS
je section_base_bss
mov rax, rbx
add rax, DATABUF_OFF
ret
section_base_bss:
mov rax, rbx
add rax, BSSBUF_OFF
ret
section_base_text:
mov rax, r14
ret

define_label:
mov r9, rax
mov rax, [r9+32]
cmp rax, 0
jne die_dup_label
push r9
call section_base                   ; rax=base, rdx=section id
mov rcx, r15
sub rcx, rax
pop r9
mov [r9+24], rcx                    ; value (offset within its section)
mov [r9+40], rdx                    ; section
mov rdx, 1
mov [r9+32], rdx                    ; status
; Record the slot in this process's defined-label list. Serial runs never
; read the list; a parallel worker walks it to tell the parent which
; labels it defined, which is far cheaper than rescanning the hash table.
mov rax, rbx
add rax, DEFLIST_META_OFF
mov rcx, [rax+0]
mov rdx, rcx
shl rdx, 3
mov rsi, rbx
add rsi, DEFLIST_OFF
add rdx, rsi
mov [rdx+0], r9
add rcx, 1
mov [rax+0], rcx
ret

; ===========================================================================
; define_const -- in: rax = symbol slot address, rdx = value. Sets
; status = 2 (CONST). Errors if status is already nonzero.
; ===========================================================================
define_const:
mov r9, rax
mov rax, [r9+32]
cmp rax, 0
je define_const_fresh
; Already defined. In a worker that is expected: par_prescan harvested
; every `equ` in the file into the shared (COW) table before forking, and
; the worker is now re-reading the very line it came from, so redefining
; it to the same value is a no-op rather than a duplicate. A genuine
; duplicate constant is still caught -- by the prescan itself, in the
; parent, before any worker exists. A name that is already a LABEL is a
; real collision either way.
cmp rax, 2
jne die_dup_label
mov rax, rbx
add rax, MYJOB_OFF
mov rax, [rax+0]
cmp rax, NEG_ONE
je die_dup_label
ret
define_const_fresh:
mov [r9+24], rdx
mov rdx, 2
mov [r9+32], rdx
ret

; ===========================================================================
; try_resolve_const -- in: rsi/rcx = name ptr/len. Looks up WITHOUT
; creating a new entry: only status=2 (CONST) counts as found; an empty
; slot ends the probe (same open-addressing scheme as
; find_or_create_symbol, see its comment).
;   out: rdx = 1 and rax = value if found; rdx = 0 if not. A found value
;   can legitimately be ANY 64-bit pattern (NEG_ONE's is all-ones), so
;   found/not-found has to be a separate flag, not a value the caller
;   compares rax against -- this dialect has no carry flag / stc-clc/jc
;   the way seed.asm (hand-assembled by nasm) could use for the same fix.
; ===========================================================================
try_resolve_const:
push rsi
push rcx
call fnv1a
pop rcx
pop rsi
mov r8, rax
mov r9, rax
mov rdx, rbx
add rdx, SYMMASK_OFF
mov rdx, [rdx+0]
and r9, rdx
trc_probe:
mov r10, r9
shl r10, 6
mov r11, rbx
add r11, SYMTAB_OFF
add r10, r11
mov rax, [r10+8]                    ; free slot = no name (see focs_probe)
cmp rax, 0
je trc_notfound
mov rax, [r10+0]
cmp rax, r8
jne trc_next
mov rax, [r10+16]
cmp rax, rcx
jne trc_next
mov rdi, [r10+8]
mov rdx, rcx
call bytes_eq
cmp rax, 1
jne trc_next
mov rax, [r10+32]
cmp rax, 2
jne trc_notfound
mov rax, [r10+24]
mov rdx, 1
ret
trc_next:
add r9, 1
mov rdx, rbx
add rdx, SYMMASK_OFF
mov rdx, [rdx+0]
and r9, rdx
jmp trc_probe
trc_notfound:
mov rax, 0
mov rdx, 0
ret

; ===========================================================================
; store_dword -- in: rdi = dest address, rax = value. Writes the low 32
; bits of rax as 4 little-endian bytes at [rdi]. v0.2's mov is always an
; 8-byte store, so this is how a rel32/imm32 field gets written without
; clobbering the 4 bytes right after it. r8/r9 saved/restored internally
; so it's safe to call from inside a loop that keeps state there.
; ===========================================================================
store_dword:
push r8
push r9
mov r8, rax
movb [rdi+0], r8
mov r9, r8
shr r9, 8
movb [rdi+1], r9
mov r9, r8
shr r9, 16
movb [rdi+2], r9
mov r9, r8
shr r9, 24
movb [rdi+3], r9
pop r9
pop r8
ret

; ===========================================================================
; add_fixup -- in: rdx = patch_off (offset from outbuf base of the field to
; patch), rax = symbol index, rcx = kind (FIX_REL32 / FIX_ABS64)
; ===========================================================================
; in: rdx=patch_off, rax=sym slot address, rcx=kind, r11=section the
; patch itself lives in (SEC_TEXT/SEC_DATA -- separate from whatever
; section the referenced SYMBOL is in, which resolve_fixups reads back
; out of the symbol slot at resolve time)
add_fixup:
mov r8, rbx
add r8, FIXUPS_META_OFF
mov r8, [r8+0]
cmp r8, FIX_CAP
jae die_toomany_fixups
mov r9, r8
shl r9, 5
mov r10, rbx
add r10, FIXUPS_OFF
add r9, r10
mov [r9+0], rdx
mov [r9+8], rax
mov [r9+16], rcx
mov [r9+24], r11
add r8, 1
mov r10, rbx
add r10, FIXUPS_META_OFF
mov [r10+0], r8
ret

; ===========================================================================
; emit_rel32_ref -- parses a label-name operand at r13. Caller has already
; emitted the opcode byte(s) at r15; this writes the 4-byte placeholder and
; records a FIX_REL32 fixup patched in after the full scan.
; ===========================================================================
emit_rel32_ref:
call scan_ident
cmp rcx, 0
je die_bad_operand
call find_or_create_symbol
mov r10, rax                        ; sym slot address
mov rdi, r15
mov rax, 0
call store_dword
call section_base                   ; rax=base, rdx=section id
mov r11, rdx                        ; add_fixup's section param
mov rdx, r15
sub rdx, rax                        ; patch_off relative to that base
mov rax, r10
mov rcx, FIX_REL32
call add_fixup
add r15, 4
ret

; ===========================================================================
; resolve_fixups -- one linear walk; patch every recorded fixup.
;   FIX_REL32: rel32 = target - (patch_off + 4), written via store_dword.
;   FIX_ABS64: qword = target + LOAD_BASE (the bias does NOT cancel here,
;   unlike rel32 -- an absolute pointer needs it added back explicitly).
; ===========================================================================
; --- pre-loop: finalize both section cursors, compute text/data sizes and
; where .data actually lands in the output file. Single-pass means this is
; the earliest point that's knowable -- a fixup or label defined mid-scan
; can't yet know where .data will start if it hasn't been scanned yet.
resolve_fixups:
mov rax, rbx
add rax, CUR_SECTION_OFF
mov rdx, [rax+0]
call sec_cursor_slot               ; park whichever cursor is live
mov [rax+0], r15
rf_sizes:
mov rax, rbx
add rax, SAVED_TEXT_R15_OFF
mov rax, [rax+0]
sub rax, r14                        ; header + text size
add rax, 4095
mov rcx, PAGE_MASK
and rax, rcx                        ; round up to a page -- text and data
                                     ; must not share a page, since they
                                     ; get different PT_LOAD permissions
mov rcx, rbx
add rcx, DATA_FILE_START_OFF
mov [rcx+0], rax
call compute_bss_vaddr

; --- per-fixup resolution. Every value below stays in a fixed register
; for the whole iteration (verified against every intervening write, not
; just declared) rather than round-tripping through the stack: rax=
; patch_off (relative to the fixup's own section, unchanged all the way
; to the final write-address add), rcx=kind, rdx=fixup's own section
; (read twice: once for the patch-offset adjustment, once for the write
; buffer choice -- both from the same untouched load), rsi/rdi=scratch,
; r11=symbol value -> becomes the absolute target, r10=fixup record
; pointer until its fields are extracted, then reused as the write
; buffer's base.
mov r8, rbx
add r8, FIXUPS_META_OFF
mov r8, [r8+0]
mov r9, 0
rf_loop:
cmp r9, r8
jae rf_done
mov r10, r9
shl r10, 5
mov rdi, rbx
add rdi, FIXUPS_OFF
add r10, rdi

mov rax, [r10+0]                    ; patch_off
mov rcx, [r10+16]                   ; kind
mov rdx, [r10+24]                   ; fixup's own section
mov rsi, [r10+8]                    ; symbol slot address (temp)

mov rdi, [rsi+32]                   ; symbol status
cmp rdi, 0
je rf_undef                         ; name the symbol, not just the failure
mov r11, [rsi+24]                   ; symbol value (relative) -> target
mov rsi, [rsi+40]                   ; symbol's own section

; Both ends are converted to virtual addresses (relative to LOAD_BASE)
; rather than file offsets: the two coincide for .text and .data, but
; .bss has no file offset at all, so vaddr is the only thing that works
; for every section.
push rax
push rcx
push rdx
mov rdx, rsi
call sec_vaddr_base
add r11, rax                        ; r11 = target vaddr
pop rdx
pop rcx
pop rax

push rax
push rcx
push rdx
call sec_vaddr_base                 ; rdx already = the patch's section
mov rsi, rax
pop rdx
pop rcx
pop rax
add rsi, rax                        ; rsi = patch vaddr

cmp rcx, FIX_ABS64
je rf_abs64

; --- FIX_REL32: rel32 = target_abs - (patch_abs + 4) ---
mov rdi, r11
sub rdi, rsi
sub rdi, 4
cmp rdx, SEC_TEXT
je rf_rel_write_text
mov r10, rbx
add r10, DATABUF_OFF
jmp rf_rel_write_haveaddr
rf_rel_write_text:
mov r10, r14
rf_rel_write_haveaddr:
add r10, rax                        ; r10 = write address (base+patch_off)
mov rax, rdi                        ; store_dword: rax=value
mov rdi, r10                        ; store_dword: rdi=dest
call store_dword
jmp rf_next

rf_abs64:
; A forward-referenced name that turned out to be an `equ` constant, not
; a label, holds a plain value -- adding the load bias to it would be
; silently wrong (it produced 0x400005 for `mov rax, LATER` / `LATER equ
; 5` before this check existed). Only real label addresses get biased.
mov rdi, [r10+8]                    ; symbol slot address (r10 is still
mov rdi, [rdi+32]                   ; the fixup record here, not yet
cmp rdi, 2                          ; reused as the write base below)
je rf_abs_nobias
add r11, LOAD_BASE                  ; r11 = absolute runtime address
rf_abs_nobias:
cmp rdx, SEC_TEXT
je rf_abs_write_text
mov r10, rbx
add r10, DATABUF_OFF
jmp rf_abs_write_haveaddr
rf_abs_write_text:
mov r10, r14
rf_abs_write_haveaddr:
add r10, rax                        ; r10 = write address (base+patch_off)
mov [r10+0], r11
rf_next:
add r9, 1
jmp rf_loop
rf_done:
ret

; rf_undef -- rsi = the unresolved symbol's slot. An undefined label is
; only discovered here, after the whole file has been scanned, so there
; is no useful line number left to report -- the name is what identifies
; it. Falls through to the shared reporter.
rf_undef:
mov rcx, [rsi+16]                  ; name_len
mov rsi, [rsi+8]                   ; name_ptr
jmp die_undef_named

; ===========================================================================
; expand_includes -- splice every `%include "file"` into the input buffer
; before anything parses it.
;
; Doing this as a textual pre-pass, rather than teaching the parser to
; switch files, means everything downstream is unchanged: the statement
; loop, the chunk boundaries the parallel pre-scan computes, and the
; fixup machinery all keep seeing one flat buffer. Re-scanning from the
; start after each splice makes nested includes work with no recursion.
;
; The cost is that a reported line number counts lines in the expanded
; text, not in the file the statement was written in. A directive that
; includes itself is caught by the expansion cap rather than running the
; buffer out of space.
;   in/out: r12 = input end (grows as files are spliced in)
; ===========================================================================
EXPAND_MAX      equ 4096

expand_includes:
mov r8, 0                          ; expansions performed
expand_scan:
mov r13, rbx                       ; cursor: restart after every splice
expand_line:
cmp r13, r12
jae expand_done
call skip_ws
cmp r13, r12
jae expand_done
movb rax, [r13+0]
cmp rax, CH_PERCENT
je expand_found
call fast_to_eol
jmp expand_line

expand_found:
mov r9, r13                        ; r9 = start of the directive line
add r13, 1
call scan_ident
cmp rcx, 7
jne die_bad_include
mov rdi, lit_include
mov rdx, 7
call bytes_eq
cmp rax, 1
jne die_bad_include
call skip_ws
cmp r13, r12
jae die_bad_include
movb rax, [r13+0]
cmp rax, CH_QUOTE
jne die_bad_include
add r13, 1
mov r10, r13                       ; r10 = first byte of the file name
expand_name:
cmp r13, r12
jae die_bad_include
movb rax, [r13+0]
cmp rax, CH_QUOTE
je expand_name_end
add r13, 1
jmp expand_name
expand_name_end:
mov r11, r13                       ; r11 = one past the name
add r13, 1
call fast_to_eol                   ; r13 = start of the line after this one

; NUL-terminate the name in place: the closing quote's byte is free to
; overwrite, since the whole line is about to be replaced anyway
push r9
push r13
mov rax, 0
movb [r11+0], rax
mov rdi, r10
call read_include                  ; -> rax = bytes read into INCBUF
pop r13
pop r9

; --- splice: the directive line becomes the file's contents ---
mov rdx, rax                       ; new length (the file's size)
mov rsi, r12
sub rsi, r13                       ; bytes following the directive
mov rdi, r9
add rdi, rdx                       ; where those bytes must end up
mov r10, rdi
add r10, rsi
mov rax, rbx
add rax, BUF_LEN
cmp r10, rax
jae die_input_too_large
push rdx                           ; mem_move_up consumes rsi as its length
push rsi                           ; and uses it as scratch, so keep a copy
mov rax, r13                       ; source of the tail
call mem_move_up                   ; rax=src rdi=dst rsi=len, copied high
                                    ; to low so a forward overlap cannot
                                    ; clobber bytes not yet moved
pop rsi
pop rdx
mov rax, r9
add rax, rdx
add rax, rsi
mov r12, rax                       ; new input end

mov rdi, r9                        ; drop the file's bytes into the gap
mov rsi, rbx
add rsi, INCBUF_OFF
mov rcx, rdx
call mem_copy

add r8, 1
cmp r8, EXPAND_MAX
jae die_include_loop
jmp expand_scan
expand_done:
ret

; read_include -- rdi = NUL-terminated path; reads the whole file into
; INCBUF. out: rax = length.
; The running byte count lives in r9, NOT r11: syscall parks RFLAGS in
; r11 and the return address in rcx, so nothing may ride through a
; syscall in either. (The caller saves r9 across this call; r8, which
; holds the expansion counter, is left alone here.)
read_include:
mov rsi, O_RDONLY
mov rax, SYS_open
syscall
cmp rax, 0
jl die_open
mov r10, rax                       ; fd
mov r9, 0                          ; bytes so far
read_include_loop:
mov rdi, rbx
add rdi, INCBUF_OFF
add rdi, r9
mov rsi, rdi
mov rdx, INCBUF_CAP
sub rdx, r9
cmp rdx, 0
je die_input_too_large
mov rdi, r10
mov rax, SYS_read
syscall
cmp rax, 0
jl die_read
je read_include_done
add r9, rax
jmp read_include_loop
read_include_done:
mov rdi, r10
mov rax, SYS_close
syscall
mov rax, r9
ret

; mem_move_up -- rax = src, rdi = dst, rsi = len, with dst >= src.
; Copies from the top down so a forward overlap cannot overwrite bytes
; that have not been moved yet.
; The regions overlap, and the direction matters: an included file may be
; longer than the directive line it replaces (tail shifts right) or
; shorter (tail shifts left). Copying top-down is only safe for a right
; shift; for a left shift it overwrites source bytes that have not been
; read yet, and vice versa. Pick the direction from the addresses.
; Uses only rax/rcx/rdx/rsi/rdi -- r8 must survive, it is the caller's
; expansion counter.
mem_move_up:
cmp rsi, 0
je mem_move_up_done
cmp rdi, rax
jae mem_move_backward
; --- dst < src: copy lowest byte first ---
mov rcx, 0
mem_move_fwd_loop:
cmp rcx, rsi
jae mem_move_up_done
mov rdx, rax
add rdx, rcx
push rsi
movb rsi, [rdx+0]
mov rdx, rdi
add rdx, rcx
movb [rdx+0], rsi
pop rsi
add rcx, 1
jmp mem_move_fwd_loop
; --- dst >= src: copy highest byte first ---
mem_move_backward:
mov rcx, rsi
mem_move_up_loop:
cmp rcx, 0
je mem_move_up_done
sub rcx, 1
mov rdx, rax
add rdx, rcx
push rsi
movb rsi, [rdx+0]
mov rdx, rdi
add rdx, rcx
movb [rdx+0], rsi
pop rsi
jmp mem_move_up_loop
mem_move_up_done:
ret

; ===========================================================================
; check_out_bounds -- has the output cursor run past the end of the
; buffer it is writing into?
;
; Every input field is range-checked, but the output buffer never was:
; emitters advance r15 with no ceiling, so a large enough source walked
; text into the data buffer and then into the symbol table, corrupting
; both with no error. Checking once per statement rather than per emitted
; byte costs nothing measurable (one compare against a bound per line)
; and still catches the overrun before anything downstream reads the
; damage -- no single statement can emit more than a handful of bytes,
; and the one that can (resb) checks itself.
;   clob: nothing (all scratch is restored)
; ===========================================================================
check_out_bounds:
push rax
push rcx
push rdx
mov rax, rbx
add rax, CUR_SECTION_OFF
mov rdx, [rax+0]
cmp rdx, SEC_TEXT
je cob_text
cmp rdx, SEC_BSS
je cob_bss
mov rcx, rbx
add rcx, DATABUF_OFF
add rcx, DATABUF_CAP
jmp cob_check
cob_bss:
mov rcx, rbx
add rcx, BSSBUF_OFF
add rcx, BSSBUF_CAP
jmp cob_check
cob_text:
mov rcx, r14
add rcx, TEXTBUF_CAP
cob_check:
cmp r15, rcx
jae die_section_overflow
pop rdx
pop rcx
pop rax
ret

; ===========================================================================
; write_phdr / write_phdr_raw -- fill one Elf64_Phdr.
;   rdi = destination, r10 = p_type, rcx = p_flags, rsi = p_offset,
;   rdx = p_vaddr (relative to LOAD_BASE for write_phdr, absolute for
;   write_phdr_raw), r8 = p_filesz, r9 = p_memsz
;
; p_type and p_flags are adjacent 4-byte fields, so they go out as one
; qword with the flags shifted into the high half -- this dialect's mov
; always writes 8 bytes, and writing them separately would have each
; store clobber the other.
;   Phdr layout: 0 type 4 flags 8 offset 16 vaddr 24 paddr 32 filesz
;                40 memsz 48 align
; ===========================================================================
write_phdr:
mov rax, LOAD_BASE
add rdx, rax
write_phdr_raw:
mov rax, rcx
shl rax, 32
add rax, r10
mov [rdi+0], rax                   ; p_type | p_flags << 32
mov [rdi+8], rsi                   ; p_offset
mov [rdi+16], rdx                  ; p_vaddr
mov [rdi+24], rdx                  ; p_paddr
mov [rdi+32], r8                   ; p_filesz
mov [rdi+40], r9                   ; p_memsz
mov rax, PAGE_SIZE
mov [rdi+48], rax                  ; p_align
ret

; ===========================================================================
; compute_bss_vaddr -- .bss occupies memory but no file bytes, so it gets
; a virtual address rather than a file offset: the next page after the
; end of .data. Everything downstream (fixups, the program header) uses
; this, which is also why fixup arithmetic is done in virtual addresses
; -- for .text and .data the two happen to coincide, but for .bss there
; is no file offset to work from at all.
; ===========================================================================
compute_bss_vaddr:
mov rax, rbx
add rax, DATA_FILE_START_OFF
mov rax, [rax+0]
mov rcx, rbx
add rcx, SAVED_DATA_R15_OFF
mov rcx, [rcx+0]
mov rdx, rbx
add rdx, DATABUF_OFF
sub rcx, rdx                        ; data size
add rax, rcx
add rax, 4095
mov rcx, PAGE_MASK
and rax, rcx
mov rcx, rbx
add rcx, BSS_VADDR_OFF
mov [rcx+0], rax
ret

; ===========================================================================
; sec_vaddr_base -- in: rdx = section id; out: rax = that section's start
; as an offset from LOAD_BASE. .text is 0, .data starts where the file
; puts it, .bss starts on the page after .data.
; ===========================================================================
sec_vaddr_base:
cmp rdx, SEC_TEXT
je sec_vaddr_text
cmp rdx, SEC_BSS
je sec_vaddr_bss
mov rax, rbx
add rax, DATA_FILE_START_OFF
mov rax, [rax+0]
ret
sec_vaddr_bss:
mov rax, rbx
add rax, BSS_VADDR_OFF
mov rax, [rax+0]
ret
sec_vaddr_text:
mov rax, 0
ret

; ===========================================================================
; mem_copy -- rdi = dst, rsi = src, rcx = length. Copies 8 bytes at a
; time with a byte tail; the merge moves megabytes, and a pure byte loop
; there costs more than the assembly it is stitching together.
;   clob: rax, rcx, rdx, rsi, rdi
; ===========================================================================
mem_copy:
mem_copy_q:
cmp rcx, 8
jl mem_copy_tail
mov rax, [rsi+0]
mov [rdi+0], rax
add rsi, 8
add rdi, 8
sub rcx, 8
jmp mem_copy_q
mem_copy_tail:
cmp rcx, 0
je mem_copy_done
movb rax, [rsi+0]
movb [rdi+0], rax
add rsi, 1
add rdi, 1
sub rcx, 1
jmp mem_copy_tail
mem_copy_done:
ret

; ===========================================================================
; PARALLEL ASSEMBLY
;
; The unit of parallelism is a process, not a thread: fork() gives every
; worker a copy-on-write clone of the entire address space, so each one
; runs the ordinary, completely unmodified assembler over its own slice
; of the source -- same encoder, same symbol table code, same emit path,
; writing through r15 exactly as it always does. Nothing is shared and
; nothing is locked, which is why no atomics are needed (and why none had
; to be added to the dialect).
;
; The only shared memory is one MAP_SHARED slot per worker. A worker
; writes only its own slot; the parent reads a slot only after wait4 has
; told it that worker is gone, which is a full memory barrier by way of
; the kernel. Determinism is preserved because the merge walks chunks in
; index order, never completion order.
;
; What has to stay serial: the pre-scan (below) and the merge. The
; pre-scan must run first because two pieces of state genuinely flow
; forward through the file -- which section is current, and what the equ
; constants are -- so a chunk cannot be assembled until they are known at
; its start.
; ===========================================================================
par_assemble:
call par_prescan
call par_spawn
call par_install_consts             ; the parent needs them too, in case a
call par_merge                      ; deferred fixup names a constant
ret

; ===========================================================================
; par_install_consts -- replay the pre-scan's constant array into whatever
; symbol table the CURRENT process is using. Called once by each worker
; (into its small private table) and once by the parent (into the full
; one). Constant counts are tiny, so doing this N+1 times costs nothing
; next to the page faults it avoids.
; ===========================================================================
par_install_consts:
mov rax, rbx
add rax, PAR_CONST_META_OFF
mov r8, [rax+0]                    ; how many constants the prescan found
mov r9, 0
pic_loop:
cmp r9, r8
jae pic_done
mov rax, r9
shl rax, 5                         ; * PAR_CONST_ENT
mov rcx, rbx
add rcx, PAR_CONST_OFF
add rax, rcx
mov rsi, [rax+0]                   ; name_ptr
mov rcx, [rax+8]                   ; name_len
mov rdx, [rax+16]                  ; value
push r8
push r9
push rdx
call find_or_create_symbol
pop rdx
call define_const
pop r9
pop r8
add r9, 1
jmp pic_loop
pic_done:
ret

; ===========================================================================
; fast_to_eol -- advance r13 past the next newline (or to the input end),
; testing 8 bytes per iteration instead of one. Same job as skip_to_eol,
; but this runs over the entire source in the serial pre-scan, where it
; was the single largest cost and therefore the cap on how much parallel
; assembly could ever win.
;
; The test is the classic zero-byte trick: XOR the word with a newline in
; every lane, so a matching lane becomes 0x00, then (v-1) & ~v & 0x80 is
; nonzero exactly when some lane is zero. On a hit, fall back to a byte
; walk over those 8 bytes to land precisely.
;
; Reading 8 bytes may run past the last line, which is safe: the input
; sits in a 64 MiB mapping far larger than any file read into it.
;   clob: rax, rcx, rdx, rsi   (leaves r8-r11 alone: the pre-scan keeps
;         its chunking state there)
; ===========================================================================
fast_to_eol:
fte_loop:
mov rax, r13
add rax, 8
cmp rax, r12
jae fte_tail
mov rax, [r13+0]
mov rcx, SWAR_NL
xor rax, rcx                       ; newline lanes become zero
mov rdx, rax
mov rcx, SWAR_ONES
sub rdx, rcx                       ; v - 0x0101..
mov rcx, rax
mov rsi, NEG_ONE
xor rcx, rsi                       ; ~v
and rdx, rcx
mov rcx, SWAR_HIGHS
and rdx, rcx
cmp rdx, 0
jne fte_tail                       ; newline somewhere in these 8
add r13, 8
jmp fte_loop
fte_tail:
cmp r13, r12
jae fte_done
movb rax, [r13+0]
add r13, 1
cmp rax, CH_NL
jne fte_tail
fte_done:
ret

; ===========================================================================
; par_prescan -- one serial pass over the source that does the minimum a
; worker cannot do for itself: track .text/.data so each chunk knows the
; section it starts in, harvest every `equ` constant into the symbol
; table (workers inherit them through COW), count lines so a worker's
; error messages carry a real line number, and cut the file into JOBS
; chunks on line boundaries.
;
; Chunk k ends at the first line start where pos*JOBS >= (k+1)*total,
; which places the cuts evenly without ever needing a divide.
; ===========================================================================
par_prescan:
mov r13, rbx                        ; cursor
mov rax, rbx
add rax, JOBS_OFF
mov r8, [rax+0]                     ; r8 = jobs
mov r9, 0                           ; r9 = chunk index
mov r10, rbx                        ; r10 = current chunk start
; A chunk must record the line and section it BEGINS at. Recording the
; running values at the moment the chunk is closed stores the state at
; its END instead, which is the next chunk's start -- every chunk then
; got the following chunk's line base (worker line numbers came out a
; whole chunk too high) and, worse, the following chunk's section, so a
; chunk that began in .data could be assembled into .text.
; stack: [rsp]=line, [rsp+8]=this chunk's first line,
;        [rsp+16]=running section, [rsp+24]=this chunk's opening section
mov rax, SEC_TEXT
push rax                            ; [rsp+24] chunk opening section
push rax                            ; [rsp+16] running section
mov rax, 1
push rax                            ; [rsp+8] chunk first line
push rax                            ; [rsp]   running line

par_prescan_line:
cmp r13, r12
jae par_prescan_eof

; --- chunk boundary check, at a line start ---
mov rax, r9
add rax, 1
cmp rax, r8
jae par_prescan_noboundary        ; last chunk runs to EOF
mov rcx, r13
sub rcx, rbx                       ; pos
imul rcx, r8                       ; pos * jobs
mov rdx, r12
sub rdx, rbx                       ; total
mov rsi, r9
add rsi, 1
imul rdx, rsi                      ; (k+1) * total
cmp rcx, rdx
jl par_prescan_noboundary
; close chunk r9: [start, r13)
mov rax, r9
shl rax, 6
mov rdi, rbx
add rdi, CHUNKTAB_OFF
add rax, rdi
mov [rax+0], r10
mov [rax+8], r13
mov rcx, [rsp+24]
mov [rax+16], rcx                  ; section this chunk BEGAN in
mov rcx, [rsp+8]
mov [rax+24], rcx                  ; line this chunk BEGAN on
; the state right here is where the next chunk starts
mov rcx, [rsp+16]
mov [rsp+24], rcx
mov rcx, [rsp+0]
mov [rsp+8], rcx
mov r10, r13
add r9, 1
par_prescan_noboundary:

call skip_ws
cmp r13, r12
jae par_prescan_eof
movb rax, [r13+0]
cmp rax, CH_NL
je par_prescan_blank
cmp rax, CH_SEMI
je par_prescan_comment
cmp rax, CH_DOT
je par_prescan_section

; --- identifier: either a label, an `equ`, or an instruction ---
call scan_ident
cmp rcx, 0
je par_prescan_comment
mov rdi, rsi                       ; stash name ptr/len across the peek
push rdi
push rcx
cmp r13, r12
jae par_prescan_ident_done
movb rax, [r13+0]
cmp rax, CH_COLON
je par_prescan_ident_done          ; label: workers handle it
call skip_ws
cmp r13, r12
jae par_prescan_ident_done
mov rsi, r13
mov rcx, 3
mov rdi, lit_equ
mov rdx, 3
call bytes_eq
cmp rax, 1
jne par_prescan_ident_done
mov rax, r13
add rax, 3
cmp rax, r12
jae par_prescan_isequ
movb rax, [rax+0]
mov rdx, class_tbl
add rdx, rax
movb rdx, [rdx+0]
and rdx, CLS_ICONT
cmp rdx, 0
jne par_prescan_ident_done
par_prescan_isequ:
; Record the constant in a flat array rather than inserting it into the
; hash table. Populating the table here would force every worker to
; inherit those pages AND to keep the parent's full-size mask, which is
; exactly the page-fault storm this avoids. Workers replay this array
; into their own small tables instead.
add r13, 3
pop rcx
pop rsi
push r8                            ; parse_imm and the store below clobber
push r9                            ; the registers holding chunk state
push r10
push rsi
push rcx
call skip_ws
call parse_imm
mov rdi, rax                       ; value
pop rcx
pop rsi
mov rax, rbx
add rax, PAR_CONST_META_OFF
mov rdx, [rax+0]
cmp rdx, PAR_CONST_CAP
jae die_toomany_syms
mov r8, rdx
shl r8, 5                          ; * PAR_CONST_ENT (32)
mov r9, rbx
add r9, PAR_CONST_OFF
add r8, r9
mov [r8+0], rsi                    ; name_ptr
mov [r8+8], rcx                    ; name_len
mov [r8+16], rdi                   ; value
add rdx, 1
mov [rax+0], rdx
pop r10
pop r9
pop r8
jmp par_prescan_comment
par_prescan_ident_done:
pop rcx
pop rdi
jmp par_prescan_comment

par_prescan_section:
add r13, 1
call scan_ident
cmp rcx, 0
je par_prescan_comment
mov rdi, rsi
push r8                            ; swar_pack uses r8 as its mask scratch
call swar_pack
pop r8
cmp rax, PACK_TEXT
je par_prescan_sec_text
cmp rax, PACK_DATA
je par_prescan_sec_data
cmp rax, PACK_BSS
je par_prescan_sec_bss
jmp par_prescan_comment
par_prescan_sec_text:
mov rax, SEC_TEXT
mov [rsp+16], rax
jmp par_prescan_comment
par_prescan_sec_data:
mov rax, SEC_DATA
mov [rsp+16], rax
jmp par_prescan_comment
par_prescan_sec_bss:
mov rax, SEC_BSS
mov [rsp+16], rax
jmp par_prescan_comment

par_prescan_blank:
add r13, 1
mov rax, [rsp+0]
add rax, 1
mov [rsp+0], rax
jmp par_prescan_line

par_prescan_comment:
call fast_to_eol
mov rax, [rsp+0]
add rax, 1
mov [rsp+0], rax
jmp par_prescan_line

par_prescan_eof:
; close the final chunk, and give any chunks we never reached an empty
; range so the spawn/merge loops can treat all JOBS uniformly
mov rax, r9
shl rax, 6
mov rdi, rbx
add rdi, CHUNKTAB_OFF
add rax, rdi
mov [rax+0], r10
mov [rax+8], r12
mov rcx, [rsp+24]
mov [rax+16], rcx                  ; section this chunk BEGAN in
mov rcx, [rsp+8]
mov [rax+24], rcx                  ; line this chunk BEGAN on
add r9, 1
par_prescan_pad:
cmp r9, r8
jae par_prescan_fin
mov rax, r9
shl rax, 6
mov rdi, rbx
add rdi, CHUNKTAB_OFF
add rax, rdi
mov [rax+0], r12
mov [rax+8], r12
mov rcx, SEC_TEXT
mov [rax+16], rcx
mov rcx, 1
mov [rax+24], rcx
add r9, 1
jmp par_prescan_pad
par_prescan_fin:
pop rax
pop rax
pop rax
pop rax
ret

; ===========================================================================
; par_spawn -- fork one worker per chunk. The child never returns from
; here: it re-points the cursor at its own chunk and falls into the
; ordinary statement loop, which ends at parse_done, which sees a
; non-negative MYJOB and diverts to par_worker_emit.
; ===========================================================================
par_spawn:
mov rax, rbx
add rax, JOBS_OFF
mov r8, [rax+0]
mov r9, 0
par_spawn_loop:
cmp r9, r8
jae par_spawn_wait
push r8
push r9
mov rax, SYS_fork
syscall
pop r9
pop r8
cmp rax, 0
je par_spawn_child
cmp rax, 0
jl die_fork
jmp par_spawn_next
par_spawn_child:
; --- in the worker now: private COW address space, own chunk ---
mov rax, rbx
add rax, MYJOB_OFF
mov [rax+0], r9
mov rax, r9
shl rax, 6
mov rdi, rbx
add rdi, CHUNKTAB_OFF
add rax, rdi
mov r13, [rax+0]                   ; cursor  = chunk start
mov r12, [rax+8]                   ; end     = chunk end
mov rcx, [rax+16]
mov rdx, rbx
add rdx, CUR_SECTION_OFF
mov [rdx+0], rcx                   ; section this chunk starts in
mov rcx, [rax+24]
mov rdx, rbx
add rdx, LINE_OFF
mov [rdx+0], rcx                   ; first line number of this chunk
; both section cursors start at their buffer origins; text keeps the
; HDR_LEN bias so a chunk-local label value needs no special casing at
; merge time (final = local + this chunk's text base)
mov r15, r14
add r15, HDR_LEN
mov rax, rbx
add rax, SAVED_TEXT_R15_OFF
mov [rax+0], r15
mov rax, rbx
add rax, SAVED_DATA_R15_OFF
mov rcx, rbx
add rcx, DATABUF_OFF
mov [rax+0], rcx
mov rax, rbx
add rax, SAVED_BSS_R15_OFF
mov rcx, rbx
add rcx, BSSBUF_OFF
mov [rax+0], rcx
; start the live cursor in whichever section this chunk begins in
mov rax, rbx
add rax, CUR_SECTION_OFF
mov rdx, [rax+0]
call sec_cursor_slot
mov r15, [rax+0]
par_spawn_child_go:
mov rax, rbx
add rax, DEFLIST_META_OFF
mov rcx, 0
mov [rax+0], rcx
mov rax, rbx
add rax, FIXUPS_META_OFF
mov rcx, 0
mov [rax+0], rcx
; Narrow this worker's symbol table to roughly its 1/N share. The table
; is untouched in the parent, so each worker faults in only the pages its
; own share actually spans -- without this, all N workers scatter their
; labels across the full 16 MiB and fault in N whole tables' worth.
; Round the worker count up to a power of two so the mask stays a mask.
mov rax, rbx
add rax, JOBS_OFF
mov rax, [rax+0]
mov rcx, 1                         ; rcx = rounded-up power of two
pscw_round:
cmp rcx, rax
jae pscw_have
shl rcx, 1
jmp pscw_round
pscw_have:
mov rdx, SYM_CAP
pscw_shift:
cmp rcx, 1
je pscw_masked
shr rdx, 1
shr rcx, 1
jmp pscw_shift
pscw_masked:
sub rdx, 1                         ; slots-1 = mask
mov rax, rbx
add rax, SYMMASK_OFF
mov [rax+0], rdx
call par_install_consts
jmp stmt_loop
par_spawn_next:
add r9, 1
jmp par_spawn_loop

par_spawn_wait:
; reap every worker; any nonzero wait status means that worker already
; printed its own diagnostic and exited nonzero, so just follow it out
mov r9, 0
par_spawn_wait_loop:
cmp r9, r8
jae par_spawn_done
push r8
push r9
mov rdi, NEG_ONE
mov rsi, rsp
sub rsi, 64
mov rcx, 0
mov [rsi+0], rcx                   ; wait4 fills only the low 4 bytes, so
                                    ; clear all 8 first -- reading stack
                                    ; garbage in the top half would look
                                    ; like a worker failure
mov rdx, 0
mov r10, 0
mov rax, SYS_wait4
syscall
mov rcx, rsp
sub rcx, 64
mov rcx, [rcx+0]
pop r9
pop r8
cmp rcx, 0
jne par_worker_failed
add r9, 1
jmp par_spawn_wait_loop
par_spawn_done:
ret

par_worker_failed:
mov rdi, 1
mov rax, SYS_exit
syscall

; ===========================================================================
; par_worker_emit -- a worker has finished assembling its chunk; hand the
; results to the parent through its MAP_SHARED slot and exit. Everything
; written here is chunk-local; the parent rebases it during the merge.
; ===========================================================================
; ===========================================================================
; par_worker_local_resolve -- patch every fixup this worker can settle by
; itself, and compact the rest for export. This is what makes parallel
; assembly actually pay: without it the parent has to hash and resolve
; every reference in the file, serially, which costs more than it saved.
;
; A fixup is chunk-position-independent, and therefore resolvable here,
; when moving the chunk cannot change the bytes:
;   * rel32 whose target and patch site are in the SAME section -- both
;     shift by that section's base at merge time, and the difference is
;     all that gets encoded, so the base cancels. This covers essentially
;     every jump and call in real code.
;   * abs64 onto an `equ` constant -- a plain value, never an address, so
;     no base and no load bias apply.
; Everything else (cross-section rel32, abs64 onto a label) genuinely
; depends on where the chunk lands, and is left for the parent.
; ===========================================================================
par_worker_local_resolve:
mov rax, rbx
add rax, FIXUPS_META_OFF
mov r8, [rax+0]                    ; total fixups
mov r9, 0                          ; read index
mov r10, 0                         ; write index (compaction target)
pwlr_loop:
cmp r9, r8
jae pwlr_done
mov rax, r9
shl rax, 5
mov rcx, rbx
add rcx, FIXUPS_OFF
add rax, rcx                       ; rax = fixup record
mov rsi, [rax+8]                   ; symbol slot
mov rdi, [rsi+32]                  ; status
cmp rdi, 0
je pwlr_keep                       ; undefined here -- another chunk owns it
mov rdx, [rax+16]                  ; kind
cmp rdx, FIX_ABS64
je pwlr_abs

; --- rel32: only when both ends sit in the same section ---
mov rcx, [rsi+40]                  ; target section
mov rdx, [rax+24]                  ; patch section
cmp rcx, rdx
jne pwlr_keep
mov rcx, [rsi+24]                  ; target value (section-relative)
mov rdi, [rax+0]                   ; patch offset (section-relative)
sub rcx, rdi
sub rcx, 4                         ; rel32
push rax
push r8
push r9
push r10
mov r11, rdx
call par_local_site                ; rdi = address to patch
mov rax, rcx
call store_dword
pop r10
pop r9
pop r8
pop rax
jmp pwlr_next

pwlr_abs:
cmp rdi, 2                         ; only an equ constant is position-free
jne pwlr_keep
mov rcx, [rsi+24]                  ; the constant's value
mov rdx, [rax+24]                  ; patch section
push rax
push r8
push r9
push r10
mov r11, rdx
mov rdi, [rax+0]
push rcx
call par_local_site
pop rcx
mov [rdi+0], rcx
pop r10
pop r9
pop r8
pop rax
jmp pwlr_next

pwlr_keep:
; retain this fixup, sliding it down over any already-resolved entries
cmp r9, r10
je pwlr_keep_bump
mov rcx, r10
shl rcx, 5
mov rdx, rbx
add rdx, FIXUPS_OFF
add rcx, rdx                       ; destination record
mov rdx, [rax+0]
mov [rcx+0], rdx
mov rdx, [rax+8]
mov [rcx+8], rdx
mov rdx, [rax+16]
mov [rcx+16], rdx
mov rdx, [rax+24]
mov [rcx+24], rdx
pwlr_keep_bump:
add r10, 1
pwlr_next:
add r9, 1
jmp pwlr_loop
pwlr_done:
mov rax, rbx
add rax, FIXUPS_META_OFF
mov [rax+0], r10                   ; only the deferred ones remain
ret

; par_local_site -- rdi = section-relative offset, r11 = section.
;   out: rdi = address of that offset in THIS worker's own buffers
par_local_site:
cmp r11, SEC_TEXT
jne par_local_site_data
add rdi, r14                       ; text offsets already carry HDR_LEN
ret
par_local_site_data:
mov rax, rbx
add rax, DATABUF_OFF
add rdi, rax
ret

par_worker_emit:
call par_worker_local_resolve
; finalize whichever section cursor is live (mirrors resolve_fixups)
mov rax, rbx
add rax, CUR_SECTION_OFF
mov rcx, [rax+0]
cmp rcx, SEC_TEXT
je par_we_save_text
mov rax, rbx
add rax, SAVED_DATA_R15_OFF
mov [rax+0], r15
jmp par_we_slot
par_we_save_text:
mov rax, rbx
add rax, SAVED_TEXT_R15_OFF
mov [rax+0], r15
par_we_slot:
mov rax, rbx
add rax, MYJOB_OFF
mov rax, [rax+0]
mov rdx, SLOT_SIZE
imul rax, rdx
mov rcx, rbx
add rcx, SHARED_OFF
mov rcx, [rcx+0]
add rax, rcx
push rax                           ; [rsp] = slot base, held throughout

; --- text bytes ---
mov rax, rbx
add rax, SAVED_TEXT_R15_OFF
mov rax, [rax+0]
mov rcx, r14
add rcx, HDR_LEN
sub rax, rcx                       ; text_size
cmp rax, SLOT_TEXT_CAP
jae par_we_toobig
mov rdi, [rsp+0]
mov rcx, rdi
add rcx, SM_TEXTSZ
mov [rcx+0], rax
push rax
add rdi, SLOT_TEXT_OFF
mov rsi, r14
add rsi, HDR_LEN
pop rcx
push rcx
call mem_copy
pop rax

; --- data bytes ---
mov rax, rbx
add rax, SAVED_DATA_R15_OFF
mov rax, [rax+0]
mov rcx, rbx
add rcx, DATABUF_OFF
sub rax, rcx                       ; data_size
cmp rax, SLOT_DATA_CAP
jae par_we_toobig
mov rdi, [rsp+0]
mov rcx, rdi
add rcx, SM_DATASZ
mov [rcx+0], rax
add rdi, SLOT_DATA_OFF
mov rsi, rbx
add rsi, DATABUF_OFF
mov rcx, rax
call mem_copy

; --- defined labels ---
mov rax, rbx
add rax, DEFLIST_META_OFF
mov r8, [rax+0]                    ; count
; A chunk with more labels than its slot holds would overrun into the
; next worker's shared slot -- MAP_SHARED memory another process is
; reading. The declared capacity is enforced here, not merely declared.
mov rax, r8
shl rax, 6                         ; * SSYM_ENT
cmp rax, SLOT_SYM_CAP
jae par_we_toobig
mov rax, [rsp+0]
mov rcx, rax
add rcx, SM_NSYM
mov [rcx+0], r8
mov r9, 0
par_we_sym_loop:
cmp r9, r8
jae par_we_sym_done
mov rax, r9
shl rax, 3
mov rcx, rbx
add rcx, DEFLIST_OFF
add rax, rcx
mov rsi, [rax+0]                   ; symbol slot address
mov rax, r9
shl rax, 6                         ; * SSYM_ENT (64)
mov rdi, [rsp+0]
add rdi, SLOT_SYM_OFF
add rdi, rax
mov rcx, [rsi+8]                   ; name_ptr
mov [rdi+0], rcx
mov rcx, [rsi+16]                  ; name_len
mov [rdi+8], rcx
mov rcx, [rsi+24]                  ; value (section-relative)
mov [rdi+16], rcx
mov rcx, [rsi+40]                  ; section
mov [rdi+24], rcx
mov rcx, [rsi+0]                   ; the name's hash, already computed
mov [rdi+32], rcx
add r9, 1
jmp par_we_sym_loop
par_we_sym_done:

; --- fixups, carried by NAME: a worker's symbol-slot addresses mean
; nothing to the parent, but the name bytes live in the input buffer,
; which is identical in every process ---
mov rax, rbx
add rax, FIXUPS_META_OFF
mov r8, [rax+0]
mov rax, r8
shl rax, 5
mov rcx, r8
shl rcx, 4
add rax, rcx                       ; * SFIX_ENT (48)
cmp rax, SLOT_FIX_CAP
jae par_we_toobig
mov rax, [rsp+0]
mov rcx, rax
add rcx, SM_NFIX
mov [rcx+0], r8
mov r9, 0
par_we_fix_loop:
cmp r9, r8
jae par_we_fix_done
mov rax, r9
shl rax, 5                         ; * FIX_ENT (32)
mov rcx, rbx
add rcx, FIXUPS_OFF
add rax, rcx                       ; rax = fixup record
mov rdx, r9                        ; *48 as (x<<5)+(x<<4): this dialect has
shl rdx, 5                         ; only two-operand imul, and the
mov rsi, r9                        ; three-operand form silently assembles
shl rsi, 4                         ; as `imul rdx, rdx` with the constant
add rdx, rsi                       ; dropped -- a wrong stride, not an error
mov rdi, [rsp+0]
add rdi, SLOT_FIX_OFF
add rdi, rdx                       ; rdi = shared entry
mov rcx, [rax+0]
mov [rdi+0], rcx                   ; patch_off
mov rcx, [rax+24]
mov [rdi+8], rcx                   ; patch section
mov rcx, [rax+16]
mov [rdi+16], rcx                  ; kind
mov rsi, [rax+8]                   ; symbol slot
mov rcx, [rsi+8]
mov [rdi+24], rcx                  ; target name_ptr
mov rcx, [rsi+16]
mov [rdi+32], rcx                  ; target name_len
mov rcx, [rsi+0]
mov [rdi+40], rcx                  ; target name hash
add r9, 1
jmp par_we_fix_loop
par_we_fix_done:
pop rax
mov rdi, 0
mov rax, SYS_exit
syscall

par_we_toobig:
mov rdi, msg_chunk_too_big
call write_cstr_fd2
mov rdi, 1
mov rax, SYS_exit
syscall

; ===========================================================================
; par_merge -- stitch the workers' slots into the parent's own buffers.
; Two passes, because a fixup in chunk 0 may target a label defined in
; chunk 5: pass 1 lays down the bytes and installs every label at its
; final address, pass 2 resolves every fixup against the completed table.
; Chunks are walked in index order, never completion order, so the output
; is identical no matter how the scheduler happened to run the workers.
; ===========================================================================
par_merge:
; Do the workers between them still have anything unresolved? If not,
; every reference in the file was settled inside the chunk that made it,
; and the merge can skip building a symbol table altogether -- which for
; ordinary code (jumps and calls land near their target) is the common
; case and the difference between parallel being a win and a loss.
mov rax, rbx
add rax, JOBS_OFF
mov r8, [rax+0]
mov r9, 0
mov r11, 0
par_merge_count:
cmp r9, r8
jae par_merge_counted
mov rax, r9
mov rdx, SLOT_SIZE
imul rax, rdx
mov rcx, rbx
add rcx, SHARED_OFF
mov rcx, [rcx+0]
add rax, rcx
add rax, SM_NFIX
mov rax, [rax+0]
add r11, rax
add r9, 1
jmp par_merge_count
par_merge_counted:
mov rax, rbx
add rax, PAR_NEEDSYM_OFF
mov [rax+0], r11
cmp r11, 0
je par_merge_filter_done

; Mark, in the filter, the low hash bits of every name a deferred fixup
; is looking for. The symbol-install loop then skips any label whose hash
; misses -- and with references overwhelmingly local, that is nearly all
; of them. False positives only cost a needless insert.
mov r9, 0
par_merge_filter_chunk:
cmp r9, r8
jae par_merge_filter_done
mov rax, r9
mov rdx, SLOT_SIZE
imul rax, rdx
mov rcx, rbx
add rcx, SHARED_OFF
mov rcx, [rcx+0]
add rax, rcx
push rax
mov rcx, rax
add rcx, SM_NFIX
mov r10, [rcx+0]
mov r11, 0
par_merge_filter_fix:
cmp r11, r10
jae par_merge_filter_next
mov rax, r11
shl rax, 5
mov rcx, r11
shl rcx, 4
add rax, rcx                       ; * SFIX_ENT (48)
mov rcx, [rsp+0]
add rcx, SLOT_FIX_OFF
add rax, rcx
mov rcx, [rax+40]                  ; target hash
and rcx, PAR_FILTER_MASK
mov rdx, rbx
add rdx, PAR_FILTER_OFF
add rdx, rcx
mov rcx, 1
movb [rdx+0], rcx
add r11, 1
jmp par_merge_filter_fix
par_merge_filter_next:
pop rax
add r9, 1
jmp par_merge_filter_chunk
par_merge_filter_done:

mov rax, rbx
add rax, JOBS_OFF
mov r8, [rax+0]
mov r9, 0
push r8
mov rax, 0
push rax                           ; [rsp]   = running text base
push rax                           ; [rsp+8] would collide; see below
; stack: [rsp]=data_base, [rsp+8]=text_base, [rsp+16]=jobs
par_merge_p1:
mov rcx, [rsp+16]
cmp r9, rcx
jae par_merge_p2_init
mov rax, r9
mov rdx, SLOT_SIZE
imul rax, rdx
mov rcx, rbx
add rcx, SHARED_OFF
mov rcx, [rcx+0]
add rax, rcx
push rax                           ; [rsp] = slot

; record this chunk's bases, then copy its bytes into place
mov rax, r9
shl rax, 6
mov rcx, rbx
add rcx, CHUNKTAB_OFF
add rax, rcx
mov rcx, [rsp+16]                  ; text_base
mov [rax+32], rcx
mov rcx, [rsp+8]                   ; data_base
mov [rax+40], rcx

mov rax, [rsp+0]
mov rcx, rax
add rcx, SM_TEXTSZ
mov rcx, [rcx+0]                   ; text size
push rcx
mov rdi, r14
add rdi, HDR_LEN
mov rdx, [rsp+24]                  ; text_base
add rdi, rdx
mov rsi, [rsp+8]
add rsi, SLOT_TEXT_OFF
pop rcx
push rcx
call mem_copy
pop rcx
mov rax, [rsp+16]
add rax, rcx
mov [rsp+16], rax                  ; text_base += text size

mov rax, [rsp+0]
mov rcx, rax
add rcx, SM_DATASZ
mov rcx, [rcx+0]
push rcx
mov rdi, rbx
add rdi, DATABUF_OFF
mov rdx, [rsp+16]                  ; data_base
add rdi, rdx
mov rsi, [rsp+8]
add rsi, SLOT_DATA_OFF
pop rcx
push rcx
call mem_copy
pop rcx
mov rax, [rsp+8]
add rax, rcx
mov [rsp+8], rax                   ; data_base += data size

; install this chunk's labels at their final addresses -- but only if
; something actually still needs looking up
mov rax, rbx
add rax, PAR_NEEDSYM_OFF
mov rax, [rax+0]
cmp rax, 0
je par_merge_sym_done
mov rax, [rsp+0]
mov rcx, rax
add rcx, SM_NSYM
mov r10, [rcx+0]
mov r11, 0
par_merge_sym:
cmp r11, r10
jae par_merge_sym_done
mov rax, r11
shl rax, 6                         ; * SSYM_ENT (64)
mov rcx, [rsp+0]
add rcx, SLOT_SYM_OFF
add rax, rcx                       ; rax = serialized symbol
; skip labels nothing is waiting on -- one byte read instead of a hash
; and an insert into a 16 MiB table
mov rcx, [rax+32]                  ; this label's hash
and rcx, PAR_FILTER_MASK
mov rdx, rbx
add rdx, PAR_FILTER_OFF
add rdx, rcx
movb rdx, [rdx+0]
cmp rdx, 0
je par_merge_sym_skip
mov rsi, [rax+0]                   ; name_ptr
mov rcx, [rax+8]                   ; name_len
mov rdx, [rax+16]                  ; local value
mov rdi, [rax+24]                  ; section
push r9                            ; r9 is the chunk index; find_or_create_
push r10                           ; symbol clobbers r8/r9/r10/r11 through
push r11                           ; fnv1a and its probe loop
push rdx
push rdi
call find_or_create_symbol         ; rsi/rcx -> rax = slot
pop rdi
pop rdx
pop r11
pop r10
pop r9
push r10
push r11
mov rcx, [rax+32]
cmp rcx, 0
jne par_merge_dup
; final value = local + this chunk's base for its section
mov rcx, r9
shl rcx, 6
mov rsi, rbx
add rsi, CHUNKTAB_OFF
add rcx, rsi
cmp rdi, SEC_TEXT
jne par_merge_sym_data
mov rsi, [rcx+32]
jmp par_merge_sym_have
par_merge_sym_data:
mov rsi, [rcx+40]
par_merge_sym_have:
add rdx, rsi
mov [rax+24], rdx
mov [rax+40], rdi
mov rdx, 1
mov [rax+32], rdx
pop r11
pop r10
par_merge_sym_skip:
add r11, 1
jmp par_merge_sym
par_merge_sym_done:
pop rax                            ; drop slot
add r9, 1
jmp par_merge_p1

par_merge_dup:
mov rdi, msg_dup
call write_cstr_fd2
mov rdi, msg_nl
call write_cstr_fd2
mov rdi, 1
mov rax, SYS_exit
syscall

par_merge_p2_init:
; both section cursors are final now: publish them so the shared output
; stage sees exactly what the serial path would have left behind
mov rax, r14
add rax, HDR_LEN
mov rcx, [rsp+8]
add rax, rcx
mov rcx, rbx
add rcx, SAVED_TEXT_R15_OFF
mov [rcx+0], rax
mov rax, rbx
add rax, DATABUF_OFF
mov rcx, [rsp+0]
add rax, rcx
mov rcx, rbx
add rcx, SAVED_DATA_R15_OFF
mov [rcx+0], rax

; DATA_FILE_START must exist before any fixup is resolved -- par_patch
; needs it to turn a data offset into a file offset. Same page-rounding
; the serial path does in resolve_fixups.
mov rax, r14
add rax, HDR_LEN
mov rcx, [rsp+8]
add rax, rcx
sub rax, r14                       ; header + total text
add rax, 4095
mov rcx, PAGE_MASK
and rax, rcx
mov rcx, rbx
add rcx, DATA_FILE_START_OFF
mov [rcx+0], rax

mov r9, 0
par_merge_p2:
mov rcx, [rsp+16]
cmp r9, rcx
jae par_merge_fin
mov rax, r9
mov rdx, SLOT_SIZE
imul rax, rdx
mov rcx, rbx
add rcx, SHARED_OFF
mov rcx, [rcx+0]
add rax, rcx
push rax                           ; [rsp] = slot
mov rcx, rax
add rcx, SM_NFIX
mov r10, [rcx+0]
mov r11, 0
par_merge_fix:
cmp r11, r10
jae par_merge_fix_done
mov rax, r11                       ; *48 = (x<<5)+(x<<4), see par_we_fix_loop
shl rax, 5
mov rcx, r11
shl rcx, 4
add rax, rcx
mov rcx, [rsp+0]
add rcx, SLOT_FIX_OFF
add rax, rcx                       ; rax = serialized fixup
push r9                            ; chunk index -- see the pass-1 note
push r10
push r11
push rax
mov rsi, [rax+24]                  ; target name_ptr
mov rcx, [rax+32]                  ; target name_len
call find_or_create_symbol
mov rdi, rax                       ; symbol slot
pop rax
pop r11
pop r10
pop r9
push r10
push r11
mov rcx, [rdi+32]
cmp rcx, 0
je par_merge_undef
mov rdx, [rdi+24]                  ; target final value
mov rsi, [rdi+40]                  ; target section
mov r8, [rdi+32]                   ; status (2 = const: no load bias)
; absolute patch position = patch_off + this chunk's base for its section
mov rcx, [rax+0]                   ; patch_off
mov rdi, [rax+8]                   ; patch section
mov r11, [rax+16]                  ; kind
push rsi
push rdx
push r8
mov rax, r9
shl rax, 6
mov rsi, rbx
add rsi, CHUNKTAB_OFF
add rax, rsi
cmp rdi, SEC_TEXT
jne par_merge_fix_pdata
mov rsi, [rax+32]
jmp par_merge_fix_phave
par_merge_fix_pdata:
mov rsi, [rax+40]
par_merge_fix_phave:
add rcx, rsi                       ; rcx = final patch offset in its section
pop r8
pop rdx
pop rsi
call par_patch                     ; rcx=patch_off rdi=patch_sec rdx=target
                                    ; rsi=target_sec r11=kind r8=status
pop r11
pop r10
add r11, 1
jmp par_merge_fix
par_merge_fix_done:
pop rax
add r9, 1
jmp par_merge_p2

par_merge_undef:
mov rcx, [rdi+16]
mov rsi, [rdi+8]
jmp die_undef_named

par_merge_fin:
pop rax
pop rax
pop rax
ret

; ===========================================================================
; par_patch -- write one resolved fixup into the merged image.
;   rcx = final patch offset (within rdi's section)
;   rdi = section the patch lives in
;   rdx = target's final value, rsi = target's section
;   r11 = kind, r8 = target status (2 = equ constant)
; Mirrors resolve_fixups' arithmetic exactly; the two must agree or the
; parallel and serial outputs would differ.
; ===========================================================================
par_patch:
push r9
push r10
push r11
; --- file offset of the target ---
; a text offset is already a file offset (header+text start the file);
; a data offset needs DATA_FILE_START added, exactly as resolve_fixups does
mov rax, rdx
cmp rsi, SEC_TEXT
je par_patch_tgt_text
mov r10, rbx
add r10, DATA_FILE_START_OFF
mov r10, [r10+0]
add rax, r10
par_patch_tgt_text:
mov r9, rax                        ; r9 = target file offset

; --- address to write, and file offset of, the patch site ---
mov rax, rcx
cmp rdi, SEC_TEXT
je par_patch_site_text
mov r10, rbx
add r10, DATA_FILE_START_OFF
mov r10, [r10+0]
add rax, r10                       ; site file offset
mov rdi, rbx
add rdi, DATABUF_OFF
add rdi, rcx                       ; site address (data buffer)
jmp par_patch_have_site
par_patch_site_text:
mov rdi, r14
add rdi, rcx                       ; site address (text buffer; rcx already
                                    ; carries the HDR_LEN bias)
par_patch_have_site:
mov r10, rax                       ; r10 = site file offset

cmp r11, FIX_ABS64
je par_patch_abs
sub r9, r10
sub r9, 4                          ; rel32 = target - (site + 4)
mov rax, r9
call store_dword                   ; rdi = site address
pop r11
pop r10
pop r9
ret

par_patch_abs:
cmp r8, 2                          ; equ constant: a plain value, never an
je par_patch_abs_nobias            ; address, so no load bias
add r9, LOAD_BASE
par_patch_abs_nobias:
mov [rdi+0], r9
pop r11
pop r10
pop r9
ret

; ===========================================================================
; emit_rr -- REX.W(+R+B) + opcode + ModRM(mod=11, reg=src, rm=dst)
;   in: r10 = opcode byte, rax = dst reg, rdx = src reg -> r15 += 3
;   Each REX/ModRM bit-field add below combines strictly disjoint bits
;   (same reasoning as seed's emit_rr, just spelled `add` since this
;   dialect has add/sub/cmp reg-imm but movb/mov only for memory -- no
;   memory-operand `or`), so add and or are interchangeable here.
; ===========================================================================
emit_rr:
mov rcx, 0x48
mov rsi, rdx
shr rsi, 3
shl rsi, 2
add rcx, rsi
mov rsi, rax
shr rsi, 3
add rcx, rsi
movb [r15+0], rcx

movb [r15+1], r10

mov rsi, rdx
and rsi, 7
shl rsi, 3
mov rdi, rax
and rdi, 7
add rsi, rdi
add rsi, 0xC0
movb [r15+2], rsi

add r15, 3
ret

; ===========================================================================
; emit_neg -- REX.W(+B) + F7 /3 + ModRM (NEG r/m64, single operand; /3 is
; an opcode extension packed into the same fixed-digit ModRM shape as
; emit_grp1_imm, just with no immediate following)
;   in: rax = reg -> r15 += 3
; ===========================================================================
emit_neg:
mov rcx, 0x48
mov rsi, rax
shr rsi, 3
add rcx, rsi
movb [r15+0], rcx
mov rcx, 0xF7
movb [r15+1], rcx
mov rsi, rax
and rsi, 7
add rsi, 0xD8                       ; mod=11(0xC0) | digit=3(0x18)
movb [r15+2], rsi
add r15, 3
ret

; ===========================================================================
; emit_mem -- REX.W(+R+B) + opcode + ModRM(mod=10)[+SIB] + disp32
;   in: r10 = opcode, rax = reg field, rdx = base reg, r9 = signed disp
;   out: r15 += 7 (no SIB) or 8 (base is rsp/r12)
; ===========================================================================
emit_mem:
mov rcx, 0x48                      ; REX.W
call emit_rex_x                    ; fold in R, X and B
movb [r15+0], rcx
add r15, 1
movb [r15+0], r10                  ; opcode
add r15, 1
call emit_modrm_sib
ret

; ===========================================================================
; emit_rex_x -- in: rcx = REX base (0x40 or 0x48), rax = reg field,
; rdx = base reg; out: rcx = REX with R, X and B set as needed.
; X comes from the index register parse_mem left behind, which is why it
; cannot simply be derived from the two register operands.
;   clob: rsi, rdi
; ===========================================================================
emit_rex_x:
mov rsi, rax
shr rsi, 3
shl rsi, 2                         ; REX.R
add rcx, rsi
mov rsi, rdx
shr rsi, 3                         ; REX.B
add rcx, rsi
mov rsi, rbx
add rsi, MEM_INDEX_OFF
mov rsi, [rsi+0]
cmp rsi, NEG_ONE
je emit_rex_x_done
shr rsi, 3
shl rsi, 1                         ; REX.X
add rcx, rsi
emit_rex_x_done:
ret

; ===========================================================================
; emit_modrm_sib -- ModRM(mod=10) [+SIB] + disp32, written through r15.
;   in: rax = reg field, rdx = base reg, r9 = disp32, plus the index and
;       scale parse_mem stored.
; A SIB byte is required whenever there is an index, and also when the
; base is rsp/r12, whose low three bits (100) are the escape that means
; "SIB follows" rather than a plain register.
; ===========================================================================
emit_modrm_sib:
mov rsi, rax
and rsi, 7
shl rsi, 3
add rsi, 0x80                      ; mod = 10 (disp32)
mov rdi, rbx
add rdi, MEM_INDEX_OFF
mov rdi, [rdi+0]
cmp rdi, NEG_ONE
jne emit_modrm_sib_indexed
mov rcx, rdx
and rcx, 7
cmp rcx, 4
je emit_modrm_sib_basesib
add rsi, rcx
movb [r15+0], rsi
add r15, 1
jmp emit_modrm_sib_disp
emit_modrm_sib_basesib:
add rsi, 4
movb [r15+0], rsi
add r15, 1
mov rcx, 0x24                      ; scale 0, index 100 (none), base 100
movb [r15+0], rcx
add r15, 1
jmp emit_modrm_sib_disp

emit_modrm_sib_indexed:
add rsi, 4                         ; rm = 100: a SIB byte follows
movb [r15+0], rsi
add r15, 1
mov rcx, rbx
add rcx, MEM_SCALE_OFF
mov rcx, [rcx+0]
shl rcx, 6                         ; scale into bits 7:6
mov rsi, rdi
and rsi, 7
shl rsi, 3                         ; index into bits 5:3
add rcx, rsi
mov rsi, rdx
and rsi, 7                         ; base into bits 2:0
add rcx, rsi
movb [r15+0], rcx
add r15, 1

emit_modrm_sib_disp:
mov rdi, r15
mov rax, r9
call store_dword
add r15, 4
ret

; ===========================================================================
; emit_movb_load -- REX.W(+R+B) + 0F B6 /r + ModRM[+SIB] + disp32
; (MOVZX r64, r/m8)
;   in: rax = dst reg, rdx = base reg, r9 = signed disp
;   out: r15 += 8 (no SIB) or 9 (base is rsp/r12)
; ===========================================================================
emit_movb_load:
mov rcx, 0x48                      ; REX.W: destination is the full 64-bit reg
call emit_rex_x
movb [r15+0], rcx
add r15, 1
mov rcx, 15
movb [r15+0], rcx
add r15, 1
mov rcx, 0xB6
movb [r15+0], rcx
add r15, 1
call emit_modrm_sib
ret

; ===========================================================================
; emit_movb_store -- REX(always present) + 88 /r + ModRM[+SIB] + disp32
; (MOV r/m8, r8 -- REX forced even when otherwise unneeded, so reg=4..7
; means SPL/BPL/SIL/DIL and never AH/CH/DH/BH)
;   in: rax = src reg, rdx = base reg, r9 = signed disp
;   out: r15 += 7 (no SIB) or 8 (base is rsp/r12)
; ===========================================================================
emit_movb_store:
; Unlike the 16/32-bit stores, this one sometimes needs a REX prefix that
; carries no bits at all: source registers 4..7 mean AH/CH/DH/BH without
; REX and SPL/BPL/SIL/DIL with it, and we always want the latter. Hence
; the force flag -- REX still has to carry its R/B bits when the operands
; are extended, so it cannot simply be written out as a bare 0x40 here.
mov r11, 0
cmp rax, 4
jl emit_movb_store_go
cmp rax, 8
jae emit_movb_store_go
mov r11, 1
emit_movb_store_go:
mov r10, 0x88
call emit_rex32_mem
ret

; ===========================================================================
; emit_movw_load -- REX.W(+R+B) + 0F B7 /r + ModRM[+SIB] + disp32
; (MOVZX r64, r/m16 -- same shape as emit_movb_load, opcode 0xB7 not
; 0xB6). REX.W is mandatory here regardless of register choice, same
; reasoning as movb: the destination is always the full 64-bit register.
;   in: rax = dst reg, rdx = base reg, r9 = signed disp
;   out: r15 += 8 (no SIB) or 9 (base is rsp/r12)
; ===========================================================================
emit_movw_load:
mov rcx, 0x48                      ; REX.W: destination is the full 64-bit reg
call emit_rex_x
movb [r15+0], rcx
add r15, 1
mov rcx, 15
movb [r15+0], rcx
add r15, 1
mov rcx, 0xB7
movb [r15+0], rcx
add r15, 1
call emit_modrm_sib
ret

; ===========================================================================
; emit_movw_store -- 66 + REX(always present) + 89 /r + ModRM[+SIB] +
; disp32 (MOV r/m16, r16). The 0x66 operand-size override must precede
; REX in the byte stream. REX isn't strictly required for 16-bit regs
; (no AH/CH/DH/BH-style ambiguity the way movb's store has), but it's
; forced anyway for the same fixed-byte-layout simplicity as movb/movd.
;   in: rax = src reg, rdx = base reg, r9 = signed disp
;   out: r15 += 8 (no SIB) or 9 (base is rsp/r12)
; ===========================================================================
emit_movw_store:
mov rcx, 0x66                      ; operand-size override, then the same
movb [r15+0], rcx                  ; body the 32-bit store uses
add r15, 1
mov r10, 0x89
mov r11, 0
call emit_rex32_mem
ret

; ===========================================================================
; emit_movd_load -- REX(always present, W=0)+8B /r+ModRM[+SIB]+disp32
; (MOV r32, r/m32 -- a plain 32-bit load, no MOVZX opcode needed: x86-64
; automatically zero-extends any 32-bit register write into the full
; 64-bit register, so this already has movb/movw's "load and zero-
; extend" behavior for free). REX carries only R/B here, never W.
;   in: rax = dst reg, rdx = base reg, r9 = signed disp
;   out: r15 += 7 (no SIB) or 8 (base is rsp/r12)
; ===========================================================================
emit_movd_load:
mov r10, 0x8B
mov r11, 0
call emit_rex32_mem
ret

; ===========================================================================
; emit_rex32_mem -- shared body for the 32-bit memory forms (and, with a
; 0x66 already emitted, the 16-bit stores): optional REX, one opcode
; byte, ModRM(mod=10)[+SIB], disp32.
;   in: r10 = opcode, rax = reg field, rdx = base reg, r9 = disp32,
;       r11 = 1 to emit REX even when it carries no bits (movb only)
;
; A 32-bit operand needs no REX.W, so REX appears only when an extended
; register forces it. Emitting 0x40 unconditionally -- which this used to
; do -- is a legal but pointless prefix that no reference assembler
; produces, and the differential test against GNU as flagged every one of
; them. Because the length now varies, the bytes go out through a moving
; cursor rather than fixed [r15+N] slots.
; ===========================================================================
emit_rex32_mem:
mov rcx, 0x40                      ; no REX.W: 32/16/8-bit operand
call emit_rex_x
cmp rcx, 0x40
jne erm_prefix
cmp r11, 0                         ; movb forces a bare REX (SPL/BPL/SIL/DIL)
je erm_noprefix
erm_prefix:
movb [r15+0], rcx
add r15, 1
erm_noprefix:
movb [r15+0], r10                  ; opcode
add r15, 1
call emit_modrm_sib
ret

; ===========================================================================
; emit_movd_store -- REX(always present, W=0)+89 /r+ModRM[+SIB]+disp32
; (MOV r/m32, r32). Same shape as emit_movd_load, opcode 0x89 not 0x8B.
;   in: rax = src reg, rdx = base reg, r9 = signed disp
;   out: r15 += 7 (no SIB) or 8 (base is rsp/r12)
; ===========================================================================
emit_movd_store:
mov r10, 0x89
mov r11, 0
call emit_rex32_mem
ret

; ===========================================================================
; emit_grp1_imm -- REX.W(+B) + 81 /digit + ModRM + imm32
;   in: r10 = /digit (0,1,4,5,6,7), rax = dst reg, r9 = imm32 value
;   out: r15 += 7
; ===========================================================================
emit_grp1_imm:
push rax                         ; the 81 /digit form carries only imm32
mov rax, r9                      ; (sign-extended at run time), so anything
call check_imm32                 ; wider than signed 32 bits cannot be
pop rax                          ; encoded here and must not be truncated
mov rcx, 0x48
mov rsi, rax
shr rsi, 3
add rcx, rsi
movb [r15+0], rcx
mov rsi, 0x81
movb [r15+1], rsi

mov rsi, rax
and rsi, 7
mov rdi, r10
shl rdi, 3
add rsi, rdi
add rsi, 0xC0
movb [r15+2], rsi

mov rdi, r15
add rdi, 3
mov rax, r9
call store_dword
add r15, 7
ret

; ===========================================================================
; emit_shift_imm -- REX.W(+B) + C1 /digit + ModRM + imm8
;   in: r10 = /digit (4 or 5), rax = dst reg, r11 = imm8 count
;   out: r15 += 4
; ===========================================================================
emit_shift_imm:
mov rcx, 0x48
mov rsi, rax
shr rsi, 3
add rcx, rsi
movb [r15+0], rcx
mov rsi, 0xC1
movb [r15+1], rsi

mov rsi, rax
and rsi, 7
mov rdi, r10
shl rdi, 3
add rsi, rdi
add rsi, 0xC0
movb [r15+2], rsi
movb [r15+3], r11

add r15, 4
ret

; ===========================================================================
; parse_mem -- parses "[reg+imm]" or "[reg-imm]" at r13 (must start '[')
;   out: rax = base register, r9 = signed disp; r13 advanced past ']'
; ===========================================================================
; Accepts [base+disp], [base-disp], and the scaled-index forms
; [base+index*scale] and [base+index*scale+disp] (scale 1, 2, 4 or 8).
; The index and scale are handed to the emitters through memory rather
; than registers -- every emitter already takes three register operands,
; and this keeps a fourth from having to thread through all of them.
parse_mem:
mov rax, rbx
add rax, MEM_INDEX_OFF
mov rcx, NEG_ONE
mov [rax+0], rcx                 ; no index until proven otherwise
cmp r13, r12
jae die_bad_operand
movb rax, [r13+0]
cmp rax, CH_LBRACKET
jne die_bad_operand
add r13, 1
call parse_reg
cmp rax, NEG_ONE
je die_bad_operand
push rax                         ; base
cmp r13, r12
jae die_bad_operand
movb rcx, [r13+0]
cmp rcx, CH_PLUS
je parse_mem_plus
cmp rcx, CH_MINUS
je parse_mem_neg
jmp die_bad_operand

parse_mem_plus:
; after '+' this is either an index register or a displacement
add r13, 1
call parse_reg                   ; leaves r13 alone when it does not match
cmp rax, NEG_ONE
je parse_mem_disp_pos
; --- index register: require *scale ---
push rax
cmp r13, r12
jae die_bad_operand
movb rcx, [r13+0]
cmp rcx, CH_STAR
jne die_bad_operand
add r13, 1
call parse_imm                   ; the scale factor itself
mov rcx, 0                       ; encode 1,2,4,8 as SIB scale 0,1,2,3
cmp rax, 1
je parse_mem_scale_ok
mov rcx, 1
cmp rax, 2
je parse_mem_scale_ok
mov rcx, 2
cmp rax, 4
je parse_mem_scale_ok
mov rcx, 3
cmp rax, 8
je parse_mem_scale_ok
jmp die_bad_scale
parse_mem_scale_ok:
mov rax, rbx
add rax, MEM_SCALE_OFF
mov [rax+0], rcx
pop rcx                          ; index register
cmp rcx, 4
je die_bad_index                 ; rsp cannot be a SIB index (100 = none)
mov rax, rbx
add rax, MEM_INDEX_OFF
mov [rax+0], rcx
; an optional displacement may follow the scaled index
cmp r13, r12
jae die_bad_operand
movb rcx, [r13+0]
cmp rcx, CH_RBRACKET
je parse_mem_zero_disp
cmp rcx, CH_PLUS
je parse_mem_idx_pos
cmp rcx, CH_MINUS
je parse_mem_idx_neg
jmp die_bad_operand
parse_mem_zero_disp:
mov rax, 0
jmp parse_mem_haveimm
parse_mem_idx_pos:
add r13, 1
call parse_imm
jmp parse_mem_haveimm
parse_mem_idx_neg:
add r13, 1
call parse_imm
mov rdx, 0
sub rdx, rax
mov rax, rdx
jmp parse_mem_haveimm

parse_mem_disp_pos:
call parse_imm
jmp parse_mem_haveimm
parse_mem_neg:
add r13, 1
call parse_imm
mov rdx, 0
sub rdx, rax
mov rax, rdx
parse_mem_haveimm:
call check_disp32                ; the ModRM forms this dialect emits all
                                 ; use mod=10 (disp32); a wider value would
                                 ; be silently truncated into that field
mov r9, rax
pop rax
cmp r13, r12
jae die_bad_operand
movb rcx, [r13+0]
cmp rcx, CH_RBRACKET
jne die_bad_operand
add r13, 1
ret

; ===========================================================================
; do_mov -- reg,imm64 / reg,reg / reg,[mem] / [mem],reg / reg,label-or-const
; ===========================================================================
do_mov:
call skip_ws
cmp r13, r12
jae die_bad_operand
movb rax, [r13+0]
cmp rax, CH_LBRACKET
je do_mov_store

call parse_reg
cmp rax, NEG_ONE
je die_bad_operand
push rax                          ; dst reg -- parse_reg/parse_imm/parse_mem
                                  ; all clobber r10/r11, so this has to live
                                  ; on the stack across them

call skip_ws
cmp r13, r12
jae die_bad_operand
movb rax, [r13+0]
cmp rax, CH_COMMA
jne die_bad_operand
add r13, 1
call skip_ws
cmp r13, r12
jae die_bad_operand
movb rax, [r13+0]
cmp rax, CH_LBRACKET
je do_mov_load

cmp rax, CH_MINUS
je do_mov_imm_numeric
cmp rax, CH_0
jl do_mov_try_reg_or_label
cmp rax, CH_9PLUS1
jae do_mov_try_reg_or_label
jmp do_mov_imm_numeric

do_mov_try_reg_or_label:
call parse_reg                    ; r13 unchanged on failure -> scan_ident
cmp rax, NEG_ONE                  ; can pick up cleanly right after
jne do_mov_regreg_have_src
call scan_ident
cmp rcx, 0
je die_bad_operand
call try_resolve_const
cmp rdx, 0
jne do_mov_const_have_value

call find_or_create_symbol        ; not a constant -- forward-capable label
mov r11, rax                      ; sym slot address
pop rax
mov r10, rax
mov rax, 0x48
mov rcx, r10
shr rcx, 3
add rax, rcx
movb [r15+0], rax
mov rcx, r10
and rcx, 7
add rcx, 0xB8
movb [r15+1], rcx
mov rcx, 0
mov [r15+2], rcx                  ; zeros the whole 8-byte placeholder
call section_base                 ; rax=base, rdx=section id
mov r9, rdx                       ; stash section id (r11 still holds
                                  ; the sym slot address at this point)
mov rdx, r15
add rdx, 2
sub rdx, rax                      ; patch_off relative to section base
mov rax, r11
mov rcx, FIX_ABS64
mov r11, r9                       ; add_fixup's section param
call add_fixup
add r15, 10
jmp do_mov_tail

do_mov_const_have_value:
mov r10, rax                      ; constant's value
pop rax                           ; dst reg
mov r11, rax
mov rax, 0x48
mov rcx, r11
shr rcx, 3
add rax, rcx
movb [r15+0], rax
mov rcx, r11
and rcx, 7
add rcx, 0xB8
movb [r15+1], rcx
mov [r15+2], r10
add r15, 10
jmp do_mov_tail

do_mov_imm_numeric:
call parse_signed_imm
mov r10, rax
pop rax
mov r11, rax
mov rax, 0x48
mov rcx, r11
shr rcx, 3
add rax, rcx
movb [r15+0], rax
mov rcx, r11
and rcx, 7
add rcx, 0xB8
movb [r15+1], rcx
mov [r15+2], r10
add r15, 10
jmp do_mov_tail

do_mov_regreg_have_src:
mov rdx, rax
pop rax
mov r10, 0x89
call emit_rr
jmp do_mov_tail

do_mov_load:
call parse_mem
mov rdx, rax
pop rax
mov r10, 0x8B
call emit_mem
jmp do_mov_tail

do_mov_store:
call parse_mem
mov rdx, rax
call skip_ws
cmp r13, r12
jae die_bad_operand
movb rax, [r13+0]
cmp rax, CH_COMMA
jne die_bad_operand
add r13, 1
call skip_ws
push rdx
push r9
call parse_reg
cmp rax, NEG_ONE
je die_bad_operand
pop r9
pop rdx
mov r10, 0x89
call emit_mem

do_mov_tail:
call skip_ws
call skip_to_eol
ret

; ===========================================================================
; add/sub/and/or/xor/cmp reg,reg-or-imm-or-const -- six near-identical
; blocks (no macro facility in this dialect); only the grp1 /digit and the
; rr opcode differ per op.
; ===========================================================================
; The six operations differ only in two constants: the /digit used by the
; 81 /r immediate form and the opcode used by the register-register form.
; They used to be six copy-pasted 54-line handlers; this is the same
; behaviour parameterised, which is what the project's own design notes
; ask for ("adding an instruction becomes adding a row to a table, not
; writing new control flow").
do_add:
mov r10, 0
mov r11, 0x01
jmp do_arith
do_or:
mov r10, 1
mov r11, 0x09
jmp do_arith
do_and:
mov r10, 4
mov r11, 0x21
jmp do_arith
do_sub:
mov r10, 5
mov r11, 0x29
jmp do_arith
do_xor:
mov r10, 6
mov r11, 0x31
jmp do_arith
do_cmp:
mov r10, 7
mov r11, 0x39
jmp do_arith

; do_arith -- in: r10 = grp1 /digit, r11 = reg-reg opcode.
; Both are pushed immediately: parse_reg, parse_signed_imm, scan_ident and
; try_resolve_const all clobber r10/r11, so nothing may stay there across
; the operand parse.
do_arith:
push r10
push r11
call skip_ws
call parse_reg
cmp rax, NEG_ONE
je die_bad_operand
push rax                           ; [rsp]=dst [rsp+8]=rr op [rsp+16]=digit
call skip_ws
cmp r13, r12
jae die_bad_operand
movb rax, [r13+0]
cmp rax, CH_COMMA
jne die_bad_operand
add r13, 1
call skip_ws
cmp r13, r12
jae die_bad_operand
movb rax, [r13+0]
cmp rax, CH_MINUS
je do_arith_imm
cmp rax, CH_0
jl do_arith_reg_or_const
cmp rax, CH_9PLUS1
jae do_arith_reg_or_const

do_arith_imm:
call parse_signed_imm
mov r9, rax
pop rax                            ; dst
pop r11
pop r10                            ; digit
call emit_grp1_imm
jmp do_arith_tail

do_arith_reg_or_const:
call parse_reg
cmp rax, NEG_ONE
jne do_arith_have_src
call scan_ident                    ; not a register: must be an equ name
cmp rcx, 0
je die_bad_operand
call try_resolve_const
cmp rdx, 0
je die_bad_operand
mov r9, rax
pop rax
pop r11
pop r10
call emit_grp1_imm
jmp do_arith_tail

do_arith_have_src:
mov rdx, rax                       ; src
pop rax                            ; dst
pop r11
pop r10
mov r10, r11                       ; emit_rr takes the opcode in r10
call emit_rr

do_arith_tail:
call skip_ws
call skip_to_eol
ret

; ===========================================================================
; resolve_imm_operand -- numeric literal or defined const at r13
;   out: rax = value; r13 advanced. Used by shift counts and db byte values.
; ===========================================================================
resolve_imm_operand:
cmp r13, r12
jae die_bad_operand
movb rax, [r13+0]
cmp rax, CH_0
jl resolve_imm_operand_const
cmp rax, CH_9PLUS1
jae resolve_imm_operand_const
call parse_imm
ret
resolve_imm_operand_const:
call scan_ident
cmp rcx, 0
je die_bad_operand
call try_resolve_const
cmp rdx, 0
je die_bad_operand
ret

; ===========================================================================
; shl/shr reg, imm8-or-const -- variable-count (shift by cl) not implemented
; ===========================================================================
do_shl:
call skip_ws
call parse_reg
cmp rax, NEG_ONE
je die_bad_operand
push rax
call skip_ws
cmp r13, r12
jae die_bad_operand
movb rax, [r13+0]
cmp rax, CH_COMMA
jne die_bad_operand
add r13, 1
call skip_ws
call resolve_imm_operand
mov r11, rax
pop rax
mov r10, 4
call emit_shift_imm
call skip_ws
call skip_to_eol
ret

do_shr:
call skip_ws
call parse_reg
cmp rax, NEG_ONE
je die_bad_operand
push rax
call skip_ws
cmp r13, r12
jae die_bad_operand
movb rax, [r13+0]
cmp rax, CH_COMMA
jne die_bad_operand
add r13, 1
call skip_ws
call resolve_imm_operand
mov r11, rax
pop rax
mov r10, 5
call emit_shift_imm
call skip_ws
call skip_to_eol
ret

; ===========================================================================
; lea reg, [reg+N] -- REX.W(+R+B) + 8D /r + ModRM[+SIB] + disp32 (LEA r64,m).
; Reuses emit_mem entirely -- same addressing-mode encoding as mov's load
; form, just opcode 0x8D instead of 0x8B, and no memory access happens at
; runtime (the effective address itself is the result).
; ===========================================================================
do_lea:
call skip_ws
call parse_reg
cmp rax, NEG_ONE
je die_bad_operand
push rax
call skip_ws
cmp r13, r12
jae die_bad_operand
movb rax, [r13+0]
cmp rax, CH_COMMA
jne die_bad_operand
add r13, 1
call skip_ws
call parse_mem
mov rdx, rax
pop rax
mov r10, 0x8D
call emit_mem
call skip_ws
call skip_to_eol
ret

; ===========================================================================
; imul reg, reg -- REX.W(+R+B) + 0F AF /r (IMUL r64, r/m64). Unlike
; add/sub/and/or/xor/cmp's "reg=src, rm=dst" (MR) encoding, this opcode's
; ModRM is "reg=dst, rm=src" (RM) -- SDM Vol2's IMUL r64,r/m64 entry -- so
; it needs its own emit routine rather than reusing emit_rr.
; ===========================================================================
emit_imul:
mov rcx, 0x48
mov rsi, rax
shr rsi, 3
shl rsi, 2
add rcx, rsi
mov rsi, rdx
shr rsi, 3
add rcx, rsi
movb [r15+0], rcx
mov rsi, 15
movb [r15+1], rsi
mov rsi, 0xAF
movb [r15+2], rsi

mov rsi, rax
and rsi, 7
shl rsi, 3
mov rdi, rdx
and rdi, 7
add rsi, rdi
add rsi, 0xC0
movb [r15+3], rsi

add r15, 4
ret

do_imul:
call skip_ws
call parse_reg
cmp rax, NEG_ONE
je die_bad_operand
push rax
call skip_ws
cmp r13, r12
jae die_bad_operand
movb rax, [r13+0]
cmp rax, CH_COMMA
jne die_bad_operand
add r13, 1
call skip_ws
cmp r13, r12
jae die_bad_operand
movb rax, [r13+0]
cmp rax, CH_MINUS
je do_imul_imm
cmp rax, CH_0
jl do_imul_reg
cmp rax, CH_9PLUS1
jae do_imul_reg

do_imul_imm:
; 69 /r id -- the three-operand form with source and destination the
; same register, which is how `imul reg, imm` is actually encoded
call parse_signed_imm
mov r9, rax
pop rax
call emit_imul_imm
jmp do_imul_tail

do_imul_reg:
call parse_reg
cmp rax, NEG_ONE
jne do_imul_have_src
call scan_ident                    ; not a register: try an equ constant
cmp rcx, 0
je die_bad_operand
call try_resolve_const
cmp rdx, 0
je die_bad_operand
mov r9, rax
pop rax
call emit_imul_imm
jmp do_imul_tail
do_imul_have_src:
mov rdx, rax
pop rax
call emit_imul
do_imul_tail:
call skip_ws
call skip_to_eol
ret

; ===========================================================================
; emit_imul_imm -- REX.W + 69 /r + imm32 (IMUL r64, r/m64, imm32), with
; ModRM naming the destination as both reg and rm so it reads as the
; two-operand `imul dst, imm`.
;   in: rax = dst reg, r9 = imm32 -> r15 += 7
; ===========================================================================
emit_imul_imm:
push rax
mov rax, r9
call check_imm32                   ; only imm32 fits; wider must not truncate
pop rax
mov rcx, 0x48
mov rsi, rax
shr rsi, 3
shl rsi, 2                         ; REX.R (dst is also the reg field)
add rcx, rsi
mov rsi, rax
shr rsi, 3                         ; REX.B (and the rm field)
add rcx, rsi
movb [r15+0], rcx
mov rcx, 0x69
movb [r15+1], rcx
mov rsi, rax
and rsi, 7
mov rdi, rsi
shl rsi, 3
add rsi, rdi
add rsi, 0xC0                      ; mod=11, reg=dst, rm=dst
movb [r15+2], rsi
mov rdi, r15
add rdi, 3
mov rax, r9
call store_dword
add r15, 7
ret

; ===========================================================================
; test reg, reg -- same encoding shape as add/sub/cmp reg,reg, so this
; just reuses emit_rr with opcode 0x85. Reg,imm form not implemented
; (the workaround, cmp reg,0, covers what this dialect's own code needs).
; ===========================================================================
do_test:
call skip_ws
call parse_reg
cmp rax, NEG_ONE
je die_bad_operand
push rax
call skip_ws
cmp r13, r12
jae die_bad_operand
movb rax, [r13+0]
cmp rax, CH_COMMA
jne die_bad_operand
add r13, 1
call skip_ws
cmp r13, r12
jae die_bad_operand
movb rax, [r13+0]
cmp rax, CH_MINUS
je do_test_imm
cmp rax, CH_0
jl do_test_reg
cmp rax, CH_9PLUS1
jae do_test_reg

do_test_imm:
; F7 /0 id -- test has its own immediate form rather than sharing the
; 81 /digit group the arithmetic ops use
call parse_signed_imm
mov r9, rax
pop rax
mov r10, 0
call emit_grp3_imm
jmp do_test_tail

do_test_reg:
call parse_reg
cmp rax, NEG_ONE
jne do_test_have_src
call scan_ident
cmp rcx, 0
je die_bad_operand
call try_resolve_const
cmp rdx, 0
je die_bad_operand
mov r9, rax
pop rax
mov r10, 0
call emit_grp3_imm
jmp do_test_tail
do_test_have_src:
mov rdx, rax
pop rax
mov r10, 0x85
call emit_rr
do_test_tail:
call skip_ws
call skip_to_eol
ret

; ===========================================================================
; emit_grp3_imm -- REX.W + F7 /digit + ModRM + imm32 (group 3: /0 is
; TEST r/m64, imm32). Same shape as emit_grp1_imm, different opcode.
;   in: r10 = /digit, rax = dst reg, r9 = imm32 -> r15 += 7
; ===========================================================================
emit_grp3_imm:
push rax
mov rax, r9
call check_imm32
pop rax
mov rcx, 0x48
mov rsi, rax
shr rsi, 3                         ; REX.B: /digit is an opcode extension,
add rcx, rsi                       ; so REX.R is never set here
movb [r15+0], rcx
mov rsi, 0xF7
movb [r15+1], rsi
mov rsi, rax
and rsi, 7
mov rdi, r10
shl rdi, 3
add rsi, rdi
add rsi, 0xC0                      ; mod = 11
movb [r15+2], rsi
mov rdi, r15
add rdi, 3
mov rax, r9
call store_dword
add r15, 7
ret

; ===========================================================================
; neg reg -- single operand
; ===========================================================================
do_neg:
call skip_ws
call parse_reg
cmp rax, NEG_ONE
je die_bad_operand
call emit_neg
call skip_ws
call skip_to_eol
ret

; ===========================================================================
; movb reg,[reg+N] / movb [reg+N],reg -- byte load/store
; ===========================================================================
; ===========================================================================
; movb / movw / movd reg,[mem] and [mem],reg -- 8/16/32-bit memory access.
; The three differ only in which pair of emitters they use, so they share
; one body and pass those in. (64-bit access is plain `mov`, handled by
; do_mov, which also has register and immediate forms these do not.)
; ===========================================================================
do_movb:
mov r10, 0
jmp do_movsz
do_movw:
mov r10, 1
jmp do_movsz
do_movd:
mov r10, 2
jmp do_movsz

; do_movsz -- in: r10 = width selector (0=byte, 1=word, 2=dword).
; Stashed on the stack straight away: parse_reg and parse_mem both
; clobber r10. A selector plus a short branch is used rather than an
; emitter address plus an indirect call, so that this file stays
; assemblable by a compiler generation that predates `call reg`.
do_movsz:
push r10
call skip_ws
cmp r13, r12
jae die_bad_operand
movb rax, [r13+0]
cmp rax, CH_LBRACKET
je do_movsz_store

call parse_reg
cmp rax, NEG_ONE
je die_bad_operand
push rax
call skip_ws
cmp r13, r12
jae die_bad_operand
movb rax, [r13+0]
cmp rax, CH_COMMA
jne die_bad_operand
add r13, 1
call skip_ws
call parse_mem                     ; -> rax = base, r9 = disp
mov rdx, rax
pop rax                            ; dst register
pop r10                            ; width selector
cmp r10, 0
je do_movsz_load_b
cmp r10, 1
je do_movsz_load_w
call emit_movd_load
jmp do_movsz_tail
do_movsz_load_b:
call emit_movb_load
jmp do_movsz_tail
do_movsz_load_w:
call emit_movw_load
jmp do_movsz_tail

do_movsz_store:
call parse_mem
mov rdx, rax
call skip_ws
cmp r13, r12
jae die_bad_operand
movb rax, [r13+0]
cmp rax, CH_COMMA
jne die_bad_operand
add r13, 1
call skip_ws
push rdx                           ; base and disp must survive parse_reg
push r9
call parse_reg
cmp rax, NEG_ONE
je die_bad_operand
pop r9
pop rdx
pop r10                            ; width selector
cmp r10, 0
je do_movsz_store_b
cmp r10, 1
je do_movsz_store_w
call emit_movd_store
jmp do_movsz_tail
do_movsz_store_b:
call emit_movb_store
jmp do_movsz_tail
do_movsz_store_w:
call emit_movw_store
jmp do_movsz_tail
do_movsz_tail:
call skip_ws
call skip_to_eol
ret

; ===========================================================================
; push/pop reg -- 50+rd/58+rd, REX.B prefix only when reg>=8
; ===========================================================================
do_push:
call skip_ws
call parse_reg
cmp rax, NEG_ONE
je die_bad_operand
mov rcx, rax
cmp rcx, 8
jl do_push_norex
mov rax, 0x41
movb [r15+0], rax
mov rdx, rcx
and rdx, 7
add rdx, 0x50
movb [r15+1], rdx
add r15, 2
jmp do_push_done
do_push_norex:
add rcx, 0x50
movb [r15+0], rcx
add r15, 1
do_push_done:
call skip_ws
call skip_to_eol
ret

do_pop:
call skip_ws
call parse_reg
cmp rax, NEG_ONE
je die_bad_operand
mov rcx, rax
cmp rcx, 8
jl do_pop_norex
mov rax, 0x41
movb [r15+0], rax
mov rdx, rcx
and rdx, 7
add rdx, 0x58
movb [r15+1], rdx
add r15, 2
jmp do_pop_done
do_pop_norex:
add rcx, 0x58
movb [r15+0], rcx
add r15, 1
do_pop_done:
call skip_ws
call skip_to_eol
ret

; ===========================================================================
; jmp/call/je/jne/jl/jae label -- opcode(s) then a rel32 label reference
; ===========================================================================
do_jmp:
call skip_ws
mov rax, 0xE9
movb [r15+0], rax
add r15, 1
call emit_rel32_ref
call skip_ws
call skip_to_eol
ret

; call takes either a label (E8 rel32) or a register (FF /2), the latter
; being an indirect call through an address held in a register -- which,
; together with `dq label`, is what makes a real function-pointer
; dispatch table expressible. parse_reg leaves the cursor untouched when
; it does not match, so the label form picks up cleanly after a miss.
do_call:
call skip_ws
call parse_reg
cmp rax, NEG_ONE
jne do_call_indirect
mov rax, 0xE8
movb [r15+0], rax
add r15, 1
call emit_rel32_ref
jmp do_call_tail

do_call_indirect:
; FF /2, mod=11: no REX.W -- a near call defaults to 64-bit operand size
; in long mode -- but REX.B is needed to reach r8..r15
mov rcx, rax
shr rcx, 3
cmp rcx, 0
je do_call_norex
mov rdx, 0x41                      ; REX.B
movb [r15+0], rdx
add r15, 1
do_call_norex:
mov rdx, 0xFF
movb [r15+0], rdx
mov rdx, rax
and rdx, 7
add rdx, 0xD0                      ; mod=11 (0xC0) | digit 2 (0x10) | rm
movb [r15+1], rdx
add r15, 2

do_call_tail:
call skip_ws
call skip_to_eol
ret

do_je:
call skip_ws
mov rax, 15
movb [r15+0], rax
mov rax, 0x84
movb [r15+1], rax
add r15, 2
call emit_rel32_ref
call skip_ws
call skip_to_eol
ret

do_jne:
call skip_ws
mov rax, 15
movb [r15+0], rax
mov rax, 0x85
movb [r15+1], rax
add r15, 2
call emit_rel32_ref
call skip_ws
call skip_to_eol
ret

do_jl:
call skip_ws
mov rax, 15
movb [r15+0], rax
mov rax, 0x8C
movb [r15+1], rax
add r15, 2
call emit_rel32_ref
call skip_ws
call skip_to_eol
ret

do_jae:
call skip_ws
mov rax, 15
movb [r15+0], rax
mov rax, 0x83
movb [r15+1], rax
add r15, 2
call emit_rel32_ref
call skip_ws
call skip_to_eol
ret

; ===========================================================================
; syscall (0F 05) / ret (C3)
; ===========================================================================
do_syscall:
mov rax, 15
movb [r15+0], rax
mov rax, 5
movb [r15+1], rax
add r15, 2
call skip_ws
call skip_to_eol
ret

do_ret:
mov rax, 0xC3
movb [r15+0], rax
add r15, 1
call skip_ws
call skip_to_eol
ret

; ===========================================================================
; db "literal" (verbatim, no escapes) or db imm8/const (single raw byte)
; ===========================================================================
do_db:
call skip_ws
cmp r13, r12
jae die_bad_operand
movb rax, [r13+0]
cmp rax, CH_QUOTE
je do_db_string

call resolve_imm_operand
movb [r15+0], rax
add r15, 1
jmp do_db_tail

do_db_string:
; Escape sequences: \n \t \r \0 \\ \" . Until these existed, "hi\n" put a
; literal backslash and n in the output, so every program that wanted a
; newline had to append it with a separate `db 10` -- which is exactly
; what the test programs did, and why their output read "hello, seed\n".
; An unrecognised escape is an error rather than a silently-kept
; backslash: guessing is how "\d" quietly becomes two bytes nobody meant.
add r13, 1
do_db_copy:
cmp r13, r12
jae die_unterminated
movb rax, [r13+0]
cmp rax, CH_QUOTE
je do_db_close
cmp rax, CH_BACKSLASH
je do_db_escape
movb [r15+0], rax
add r15, 1
add r13, 1
jmp do_db_copy

do_db_escape:
add r13, 1
cmp r13, r12
jae die_unterminated
movb rax, [r13+0]
cmp rax, CH_n
je do_db_esc_nl
cmp rax, CH_t
je do_db_esc_tab
cmp rax, CH_r
je do_db_esc_cr
cmp rax, CH_0
je do_db_esc_nul
cmp rax, CH_BACKSLASH
je do_db_esc_self
cmp rax, CH_QUOTE
je do_db_esc_self
jmp die_bad_escape
do_db_esc_nl:
mov rax, 10
jmp do_db_esc_put
do_db_esc_tab:
mov rax, 9
jmp do_db_esc_put
do_db_esc_cr:
mov rax, 13
jmp do_db_esc_put
do_db_esc_nul:
mov rax, 0
jmp do_db_esc_put
do_db_esc_self:
movb rax, [r13+0]                  ; \\ and \" stand for themselves
do_db_esc_put:
movb [r15+0], rax
add r15, 1
add r13, 1
jmp do_db_copy

do_db_close:
add r13, 1
do_db_tail:
call skip_ws
call skip_to_eol
ret

; ===========================================================================
; dw / dd / dq -- emit a 2, 4 or 8 byte little-endian value.
;
; dq additionally accepts a LABEL, which is what makes a jump table
; expressible at all: the value is a placeholder plus an ABS64 fixup, the
; same mechanism `mov reg, label` uses, so it resolves to a runtime
; address and works across .text/.data and across parallel chunks.
; dw/dd take numbers or equ constants only -- a 2 or 4 byte slot cannot
; hold a 64-bit address, and silently truncating one would be exactly the
; class of quiet wrong answer the range checks elsewhere exist to prevent.
; ===========================================================================
do_dw:
call skip_ws
call resolve_imm_operand
movb [r15+0], rax
shr rax, 8
movb [r15+1], rax
add r15, 2
call skip_ws
call skip_to_eol
ret

do_dd:
call skip_ws
call resolve_imm_operand
mov rdi, r15
call store_dword
add r15, 4
call skip_ws
call skip_to_eol
ret

do_dq:
call skip_ws
cmp r13, r12
jae die_bad_operand
movb rax, [r13+0]
cmp rax, CH_MINUS
je do_dq_number
cmp rax, CH_0
jl do_dq_symbol
cmp rax, CH_9PLUS1
jae do_dq_symbol
do_dq_number:
call parse_signed_imm
mov [r15+0], rax
add r15, 8
jmp do_dq_tail

do_dq_symbol:
; an equ constant resolves to its value; anything else is a label address
call scan_ident
cmp rcx, 0
je die_bad_operand
call try_resolve_const
cmp rdx, 0
je do_dq_label
mov [r15+0], rax
add r15, 8
jmp do_dq_tail

do_dq_label:
call find_or_create_symbol
mov r10, rax                       ; symbol slot
mov rcx, 0
mov [r15+0], rcx                   ; placeholder, patched by the fixup pass
call section_base                  ; rax = base, rdx = section id
mov r11, rdx
mov rdx, r15
sub rdx, rax                       ; patch offset within this section
mov rax, r10
mov rcx, FIX_ABS64
call add_fixup
add r15, 8

do_dq_tail:
call skip_ws
call skip_to_eol
ret

; ===========================================================================
; parse_stmt -- "ident:" defines a label, "ident equ imm" defines a
; constant, otherwise ident is a mnemonic matched by a compare chain.
;   r10/r11 stash word1 (name ptr/len) across everything below -- neither
;   is touched by find_or_create_symbol, scan_ident, parse_imm, or bytes_eq
;   (verified against each routine's own clobber list), so this is safe
;   without needing the stack.
; ===========================================================================
parse_stmt:
cmp r13, r12
jae parse_stmt_ident
movb rax, [r13+0]
cmp rax, CH_DOT
jne parse_stmt_ident
add r13, 1
call scan_ident
cmp rcx, 0
je die_unknown_mnem
mov rdi, rsi
call swar_pack
cmp rax, PACK_TEXT
je do_section_text
cmp rax, PACK_DATA
je do_section_data
cmp rax, PACK_BSS
je do_section_bss
jmp die_unknown_mnem

parse_stmt_ident:
call scan_ident
cmp rcx, 0
je die_unknown_mnem
mov r10, rsi
mov r11, rcx

cmp r13, r12
jae parse_stmt_checkequ
movb rax, [r13+0]
cmp rax, CH_COLON
jne parse_stmt_checkequ

add r13, 1
mov rsi, r10
mov rcx, r11
call find_or_create_symbol
call define_label
; A label may be followed on the same line by the statement it labels --
; `buf: resb 64`, `loop: mov rax, rbx`. Skipping to end-of-line here, as
; this used to, silently threw that statement away: the label was
; defined, the instruction never emitted, and nothing was reported. Any
; remainder is re-entered as a statement in its own right (a tail call,
; so the original caller's return address still applies).
call skip_ws
cmp r13, r12
jae parse_stmt_label_eol
movb rax, [r13+0]
cmp rax, CH_NL
je parse_stmt_label_eol
cmp rax, CH_SEMI
je parse_stmt_label_eol
jmp parse_stmt
parse_stmt_label_eol:
call skip_to_eol
ret

parse_stmt_checkequ:
call skip_ws
cmp r13, r12
jae parse_stmt_dispatch
mov rsi, r13
mov rcx, 3
mov rdi, lit_equ
mov rdx, 3
call bytes_eq
cmp rax, 1
jne parse_stmt_dispatch
mov rax, r13
add rax, 3
cmp rax, r12
jae parse_stmt_isequ
movb rax, [rax+0]
mov rdx, class_tbl
add rdx, rax
movb rdx, [rdx+0]
and rdx, CLS_ICONT
cmp rdx, 0
jne parse_stmt_dispatch
parse_stmt_isequ:
add r13, 3
mov rsi, r10
mov rcx, r11
call find_or_create_symbol
mov r9, rax
call skip_ws
call parse_imm
mov rdx, rax
mov rax, r9
call define_const
call skip_ws
call skip_to_eol
ret

; SWAR dispatch: pack+mask the candidate word ONCE (content and length
; both folded into one qword), then each mnemonic check is a single
; cmp/je -- no per-candidate call, no byte loop. Bucketed by first byte
; first (a plain compare chain, since this dialect has no `dq label`
; jump-table support to do it branchlessly), so a run starting with a
; letter no mnemonic uses skips the whole rest of the chain immediately.
parse_stmt_dispatch:
mov rdi, r10
mov rcx, r11
call swar_pack
mov r8, rax                         ; r8 = masked packed candidate word
movb r9, [r10+0]                    ; r9 = first byte, for bucketing

cmp r9, 97                          ; 'a': add, and
jne parse_stmt_bucket_c
cmp r8, PACK_ADD
je parse_stmt_call_add
cmp r8, PACK_AND
je parse_stmt_call_and
jmp die_unknown_mnem

parse_stmt_bucket_c:
cmp r9, 99                          ; 'c': cmp, call
jne parse_stmt_bucket_d
cmp r8, PACK_CMP
je parse_stmt_call_cmp
cmp r8, PACK_CALL
je parse_stmt_call_call
jmp die_unknown_mnem

parse_stmt_bucket_d:
cmp r9, 100                         ; 'd': db, dw, dd, dq
jne parse_stmt_bucket_i
cmp r8, PACK_DB
je parse_stmt_call_db
cmp r8, PACK_DW
je parse_stmt_call_dw
cmp r8, PACK_DD
je parse_stmt_call_dd
cmp r8, PACK_DQ
je parse_stmt_call_dq
jmp die_unknown_mnem

parse_stmt_bucket_i:
cmp r9, 105                         ; 'i': imul
jne parse_stmt_bucket_j
cmp r8, PACK_IMUL
je parse_stmt_call_imul
jmp die_unknown_mnem

parse_stmt_bucket_j:
cmp r9, 106                         ; 'j': jmp, je, jne, jl, jae
jne parse_stmt_bucket_l
cmp r8, PACK_JMP
je parse_stmt_call_jmp
cmp r8, PACK_JE
je parse_stmt_call_je
cmp r8, PACK_JNE
je parse_stmt_call_jne
cmp r8, PACK_JL
je parse_stmt_call_jl
cmp r8, PACK_JAE
je parse_stmt_call_jae
jmp die_unknown_mnem

parse_stmt_bucket_l:
cmp r9, 108                         ; 'l': lea
jne parse_stmt_bucket_m
cmp r8, PACK_LEA
je parse_stmt_call_lea
jmp die_unknown_mnem

parse_stmt_bucket_m:
cmp r9, 109                         ; 'm': mov, movb, movw, movd
jne parse_stmt_bucket_n
cmp r8, PACK_MOV
je parse_stmt_call_mov
cmp r8, PACK_MOVB
je parse_stmt_call_movb
cmp r8, PACK_MOVW
je parse_stmt_call_movw
cmp r8, PACK_MOVD
je parse_stmt_call_movd
jmp die_unknown_mnem

parse_stmt_bucket_n:
cmp r9, 110                         ; 'n': neg
jne parse_stmt_bucket_o
cmp r8, PACK_NEG
je parse_stmt_call_neg
jmp die_unknown_mnem

parse_stmt_bucket_o:
cmp r9, 111                         ; 'o': or
jne parse_stmt_bucket_p
cmp r8, PACK_OR
je parse_stmt_call_or
jmp die_unknown_mnem

parse_stmt_bucket_p:
cmp r9, 112                         ; 'p': push, pop
jne parse_stmt_bucket_r
cmp r8, PACK_PUSH
je parse_stmt_call_push
cmp r8, PACK_POP
je parse_stmt_call_pop
jmp die_unknown_mnem

parse_stmt_bucket_r:
cmp r9, 114                         ; 'r': ret, resb
jne parse_stmt_bucket_s
cmp r8, PACK_RET
je parse_stmt_call_ret
cmp r8, PACK_RESB
je parse_stmt_call_resb
jmp die_unknown_mnem

parse_stmt_bucket_s:
cmp r9, 115                         ; 's': syscall, sub, shl, shr
jne parse_stmt_bucket_t
mov rax, PACK_SYSCALL               ; 7 bytes -- doesn't fit the 32-bit
cmp r8, rax                         ; imm cmp encodes (unlike every other
je parse_stmt_call_syscall          ; PACK_* here, all <=4 ASCII bytes,
                                    ; so always sign-extend safely); load
                                    ; it via mov's real imm64 form instead
cmp r8, PACK_SUB
je parse_stmt_call_sub
cmp r8, PACK_SHL
je parse_stmt_call_shl
cmp r8, PACK_SHR
je parse_stmt_call_shr
jmp die_unknown_mnem

parse_stmt_bucket_t:
cmp r9, 116                         ; 't': test
jne parse_stmt_bucket_x
cmp r8, PACK_TEST
je parse_stmt_call_test
jmp die_unknown_mnem

parse_stmt_bucket_x:
cmp r9, 120                         ; 'x': xor
jne die_unknown_mnem
cmp r8, PACK_XOR
je parse_stmt_call_xor
jmp die_unknown_mnem

parse_stmt_call_mov:
call do_mov
ret
parse_stmt_call_movb:
call do_movb
ret
parse_stmt_call_movw:
call do_movw
ret
parse_stmt_call_movd:
call do_movd
ret
parse_stmt_call_syscall:
call do_syscall
ret
parse_stmt_call_ret:
call do_ret
ret
parse_stmt_call_resb:
call do_resb
ret
parse_stmt_call_db:
call do_db
ret
parse_stmt_call_dw:
call do_dw
ret
parse_stmt_call_dd:
call do_dd
ret
parse_stmt_call_dq:
call do_dq
ret
parse_stmt_call_lea:
call do_lea
ret
parse_stmt_call_imul:
call do_imul
ret
parse_stmt_call_test:
call do_test
ret
parse_stmt_call_neg:
call do_neg
ret
parse_stmt_call_add:
call do_add
ret
parse_stmt_call_sub:
call do_sub
ret
parse_stmt_call_and:
call do_and
ret
parse_stmt_call_or:
call do_or
ret
parse_stmt_call_xor:
call do_xor
ret
parse_stmt_call_cmp:
call do_cmp
ret
parse_stmt_call_shl:
call do_shl
ret
parse_stmt_call_shr:
call do_shr
ret
parse_stmt_call_jmp:
call do_jmp
ret
parse_stmt_call_je:
call do_je
ret
parse_stmt_call_jne:
call do_jne
ret
parse_stmt_call_jl:
call do_jl
ret
parse_stmt_call_jae:
call do_jae
ret
parse_stmt_call_call:
call do_call
ret
parse_stmt_call_push:
call do_push
ret
parse_stmt_call_pop:
call do_pop
ret

; ===========================================================================
; .text / .data -- switch which buffer r15 (the output bump pointer) is
; currently advancing through. Symmetric: save the outgoing section's
; cursor into its own slot, load the incoming section's saved cursor into
; r15, update the current-section flag. A no-op if already in that
; section (e.g. two ".text" in a row).
; ===========================================================================
do_section_text:
mov rcx, SEC_TEXT
jmp do_section_switch
do_section_data:
mov rcx, SEC_DATA
jmp do_section_switch
do_section_bss:
mov rcx, SEC_BSS
jmp do_section_switch

; do_section_switch -- in: rcx = target section. Park the live cursor in
; the section it belongs to, pick up the target's, and record the change.
; Written generically rather than as a pair of text<->data special cases,
; since there are three sections now.
do_section_switch:
mov rax, rbx
add rax, CUR_SECTION_OFF
mov rdx, [rax+0]
cmp rdx, rcx
je do_section_switch_done
push rcx
call sec_cursor_slot               ; rdx = current section -> rax = slot
mov [rax+0], r15
pop rcx
push rcx
mov rdx, rcx
call sec_cursor_slot               ; target's slot
mov r15, [rax+0]
pop rcx
mov rax, rbx
add rax, CUR_SECTION_OFF
mov [rax+0], rcx
do_section_switch_done:
call skip_ws
call skip_to_eol
ret

; sec_cursor_slot -- in: rdx = section id; out: rax = address of that
; section's saved-cursor slot.
sec_cursor_slot:
cmp rdx, SEC_TEXT
je sec_cursor_slot_text
cmp rdx, SEC_BSS
je sec_cursor_slot_bss
mov rax, rbx
add rax, SAVED_DATA_R15_OFF
ret
sec_cursor_slot_bss:
mov rax, rbx
add rax, SAVED_BSS_R15_OFF
ret
sec_cursor_slot_text:
mov rax, rbx
add rax, SAVED_TEXT_R15_OFF
ret

; ===========================================================================
; resb N -- reserve N zero bytes. Only meaningful in .bss, where it just
; advances the cursor: nothing is written, so the pages stay untouched
; and the bytes never reach the file. Reserving space in .text or .data
; would have to emit real zeros, which `db` already does, so it is an
; error rather than a silently different meaning.
; ===========================================================================
do_resb:
mov rax, rbx
add rax, CUR_SECTION_OFF
mov rax, [rax+0]
cmp rax, SEC_BSS
jne die_resb_section
call skip_ws
call resolve_imm_operand
; The reservation is the one place a single statement can move the
; output cursor arbitrarily far, so it is checked here rather than
; relying on the per-statement bound below. (resolve_imm_operand parses
; unsigned, so a negative count is already rejected as a bad operand.)
mov rcx, rbx
add rcx, BSSBUF_OFF
add rcx, BSSBUF_CAP
sub rcx, r15                       ; bytes still available in .bss
cmp rcx, rax
jl die_section_overflow
add r15, rax
call skip_ws
call skip_to_eol
ret

; ===========================================================================
; die_* -- error exits. fd 2, distinct message each, status 1.
;   Messages are NUL-terminated and die() computes the length at runtime
;   by scanning for that 0 byte -- this dialect's equ takes only a literal
;   number (no NASM-style "$ - label" expression), so hand-counting every
;   message's byte length would be pure transcription risk for no benefit.
; ===========================================================================
die_mmap:
mov rdi, msg_mmap
jmp die
die_open:
mov rdi, msg_open
jmp die
die_fork:
mov rdi, msg_fork
jmp die
die_read:
mov rdi, msg_read
jmp die
die_input_too_large:
mov rdi, msg_toolarge
jmp die
die_write:
mov rdi, msg_write
jmp die
die_unknown_mnem:
mov rdi, msg_unknown
jmp die_at_line
die_bad_operand:
mov rdi, msg_operand
jmp die_at_line
die_dup_label:
mov rdi, msg_dup
jmp die_at_line
die_undef_label:
mov rdi, msg_undef
jmp die_at_line

; die_undef_named -- rsi/rcx = the name that was never defined. Prints
; "v1: undefined label: NAME" and exits. No line number: by the time
; fixups are resolved the scan is over, and the name is the useful part.
die_undef_named:
push rsi
push rcx
mov rdi, msg_undef
call write_cstr_fd2
mov rdi, msg_colonsp
call write_cstr_fd2
pop rdx                            ; length
pop rsi                            ; pointer
mov rdi, 2
mov rax, SYS_write
syscall
mov rdi, msg_nl
call write_cstr_fd2
mov rdi, 1
mov rax, SYS_exit
syscall
die_toomany_syms:
mov rdi, msg_toomanysyms
jmp die_at_line
die_toomany_fixups:
mov rdi, msg_toomanyfix
jmp die_at_line
die_imm_range:
mov rdi, msg_immrange
jmp die_at_line
die_bad_escape:
mov rdi, msg_badescape
jmp die_at_line
die_unterminated:
mov rdi, msg_unterminated
jmp die_at_line
die_bad_scale:
mov rdi, msg_badscale
jmp die_at_line
die_bad_index:
mov rdi, msg_badindex
jmp die_at_line
die_resb_section:
mov rdi, msg_resbsection
jmp die_at_line
die_section_overflow:
mov rdi, msg_sectionoverflow
jmp die_at_line
die_bad_include:
mov rdi, msg_badinclude
jmp die
die_include_loop:
mov rdi, msg_includeloop
jmp die
die_disp_range:
mov rdi, msg_disprange
jmp die_at_line

; write_cstr_fd2 -- in: rdi = NUL-terminated string ptr -> writes it to fd 2
write_cstr_fd2:
mov rsi, rdi
mov rcx, 0
wcf_loop:
movb rax, [rsi+0]
cmp rax, 0
je wcf_done
add rsi, 1
add rcx, 1
jmp wcf_loop
wcf_done:
mov rdx, rcx
mov rsi, rdi
mov rdi, 2
mov rax, SYS_write
syscall
ret

; die -- rdi = NUL-terminated message (already has its own trailing
; newline). For I/O-level failures (mmap/read/write), no line number.
die:
call write_cstr_fd2
mov rdi, 1
mov rax, SYS_exit
syscall

; die_at_line -- rdi = NUL-terminated message (NO trailing newline).
; Appends " at line N\n" using the running line counter, then exits 1.
die_at_line:
call write_cstr_fd2
mov rdi, msg_atline
call write_cstr_fd2
mov rax, rbx
add rax, LINE_OFF
mov rax, [rax+0]
call print_udec
; column, so the message points at the offending token rather than just
; the line. The cursor has usually stopped exactly where parsing gave up.
mov rdi, msg_atcol
call write_cstr_fd2
mov rax, rbx
add rax, LINE_START_OFF
mov rax, [rax+0]
mov rcx, r13
sub rcx, rax
add rcx, 1                         ; columns read naturally from 1
mov rax, rcx
call print_udec
mov rdi, msg_nl
call write_cstr_fd2
mov rdi, 1
mov rax, SYS_exit
syscall

; ===========================================================================
; print_udec -- rax = unsigned value; writes its decimal digits to fd 2.
; No div/imul in this dialect, so digits come from repeated subtraction
; against a fixed set of powers of ten (largest first), skipping leading
; zeros. Buffers into the red zone, then one write for the whole number.
;   clob: rax, rcx, rdx, rsi, rdi, r8, r9, r10, r11
; ===========================================================================
print_udec:
mov r8, rax
mov r9, rsp
sub r9, 40
mov r10, 0
mov r11, 0
mov rax, 100000000
call pud_digit
mov rax, 10000000
call pud_digit
mov rax, 1000000
call pud_digit
mov rax, 100000
call pud_digit
mov rax, 10000
call pud_digit
mov rax, 1000
call pud_digit
mov rax, 100
call pud_digit
mov rax, 10
call pud_digit
mov rax, 1
call pud_digit
mov rsi, r9
mov rdx, r10
mov rdi, 2
mov rax, SYS_write
syscall
ret

; pud_digit -- in: rax = this digit's power of ten; r8 = remaining value
; (updated in place); r9 = buffer base; r10 = write index (updated);
; r11 = "seen a nonzero digit yet" flag (updated). Emits nothing for a
; leading zero digit, except the ones place (power=1), which always emits
; (so that the value 0 itself still prints one digit).
pud_digit:
mov rcx, 0
pud_digit_loop:
cmp r8, rax
jl pud_digit_done
sub r8, rax
add rcx, 1
jmp pud_digit_loop
pud_digit_done:
cmp rcx, 0
jne pud_digit_mark
cmp r11, 0
jne pud_digit_write
cmp rax, 1
je pud_digit_write
ret
pud_digit_mark:
mov r11, 1
pud_digit_write:
add rcx, 48
mov rdx, r9
add rdx, r10
movb [rdx+0], rcx
add r10, 1
ret

