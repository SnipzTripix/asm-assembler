; "equ" is still checked via bytes_eq in parse_stmt_checkequ (a one-off
; peek, not worth its own SWAR path); every mnemonic literal that used to
; back the old bytes_eq dispatch chain is gone now that dispatch is
; SWAR+bucketed (see PACK_* constants and parse_stmt_dispatch above).
lit_equ:
db "equ"
lit_include:
db "include"

